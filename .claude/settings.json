{
  "env": {
    "ENABLE_TOOL_SEARCH": "true"
  },
  "permissions": {
    "allow": [
      "mcp__legacy-sports-aws__aws_apigateway_inspect",
      "mcp__legacy-sports-aws__aws_lambda_status",
      "mcp__legacy-sports-aws__aws_logs_tail",
      "mcp__legacy-sports-aws__aws_sso_status",
      "mcp__legacy-sports-browser__*",
      "mcp__legacy-sports-ci__*",
      "mcp__legacy-sports-db__*",
      "mcp__legacy-sports-github__*",
      "mcp__legacy-sports-jira__*",
      "mcp__legacy-sports-make__*",
      "mcp__legacy-sports-nx__*",
      "mcp__worktree__worktree_checkout_file",
      "mcp__worktree__worktree_clean",
      "mcp__worktree__worktree_commit",
      "mcp__worktree__worktree_conflict_info",
      "mcp__worktree__worktree_diff",
      "mcp__worktree__worktree_guard",
      "mcp__worktree__worktree_list",
      "mcp__worktree__worktree_lock",
      "mcp__worktree__worktree_log",
      "mcp__worktree__worktree_ls_tree",
      "mcp__worktree__worktree_push",
      "mcp__worktree__worktree_rebase_continue",
      "mcp__worktree__worktree_rebase",
      "mcp__worktree__worktree_resolve_conflict",
      "mcp__worktree__worktree_set",
      "mcp__worktree__worktree_show_file",
      "mcp__worktree__worktree_show",
      "mcp__worktree__worktree_stabilize",
      "mcp__worktree__worktree_status",
      "mcp__worktree__worktree_unjunction",
      "mcp__worktree__worktree_unlock",
      "mcp__worktree__worktree_unstage"
    ]
  },
  "enabledMcpjsonServers": [
    "legacy-sports-aws",
    "legacy-sports-browser",
    "legacy-sports-ci",
    "legacy-sports-db",
    "legacy-sports-github",
    "legacy-sports-jira",
    "legacy-sports-make",
    "legacy-sports-nx",
    "worktree"
  ],
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/cleanup-worktree-junction.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/check-github-auth.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/cleanup-orphaned-junctions.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/guard-main-repo.sh"
          }
        ]
      },
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/guard-bash-mcp-first.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true
  }
}
