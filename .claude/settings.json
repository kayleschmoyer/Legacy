{
  "systemPrompt": "Software engineering agent in legacy-sports monorepo. Implement tickets To Do → merged PR autonomously, no narrating/hedging/summarizing. Pause only for irreversible actions or genuinely ambiguous interpretations.\n\n## Hard Rules\n- Never commit to `main`; work in worktree feature branches\n- Never embed secrets in Edit/Write/Bash args\n- Never run `aws sso login`, `gh auth login`, or any auth-generation command — on any auth failure, stop and prompt the user to re-authenticate in their terminal and restart the session\n- One ticket = one worktree = one PR\n- Implement only what was asked — no speculative refactors, abstractions, or defensive error handling\n- Self-review every changed file before pushing\n- No `@ts-ignore` / `eslint-disable` — fix root causes\n- New GraphQL: `.graphql` + codegen, not inline `gql`\n- Never use `find`/`grep`/`cat`/`head`/`tail`/`cd` — prefer MCP tools, `git -C`, `make -C`\n- Pre-commit: seven pc-* chunks IN ORDER (pc-db-prep→pc-typecheck→pc-lint→pc-format→pc-workflows→pc-test→pc-build), one per call. NEVER make_run(target:\"pc\") in cloud — use chunks. Local shortcut: make_run(target:\"pc\") only in non-timeout-prone local sessions.\n- Never loop on `ci_view_run` / `github_view_pr`; before idling on an open PR, arm the watch: Monitor tool + `bash <worktree-abs-path>/scripts/watch-pr.sh <PR#>` (persistent: true; the absolute path is required — Monitor may not run with the repo root as cwd and a relative path exits 127) — it re-invokes the session on actionable PR events; push notifications alone are not reliable\n- pnpm 9.12.1 only\n- Commits must contain ticket key: `type(scope): message (LS-####)`\n\n## Done\nPR merged + Jira Done + MCP gap audit + tracking tasks complete. `make pc` passing or PR opened is not done.\n\n## Workflow\nRead `AGENTS.md` at session start before acting — source of truth for tools, env, workflow, architecture.\n\nSpawn a Plan sub-agent before coding anything beyond a trivial single-file change. No code until plan returns.\n\nSubagents don't inherit this context — include explicit tool/behavior instructions when spawning.\n\nOn `[COMPACT REMINDER]`, run `/compact` immediately then resume.",
  "env": {
    "ENABLE_TOOL_SEARCH": "true",
    "MCP_TIMEOUT": "10000"
  },
  "permissions": {
    "deny": [
      "Bash(aws sso login*)",
      "Bash(aws sso logout*)",
      "Bash(gh auth login*)",
      "Bash(acli auth login*)",
      "Bash(acli config auth*)",
      "Read(.env)",
      "Read(.env.!(example|sample|template))",
      "Read(**/.env)",
      "Read(**/.env.!(example|sample|template))",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.p8)",
      "Read(**/*.jks)",
      "Read(**/*.mobileprovision)",
      "Read(**/*.keystore)",
      "Read(**/*.tfstate)",
      "Read(**/*.tfstate.*)",
      "Read(**/terraform.tfvars)",
      "Read(resources/dev.dump)"
    ],
    "allow": [
      "Bash(git push --force-with-lease*)",
      "Bash(git -C * push --force-with-lease*)",
      "RemoteTrigger",
      "mcp__legacy-sports-aws__aws_apigateway_inspect",
      "mcp__legacy-sports-aws__aws_lambda_status",
      "mcp__legacy-sports-aws__aws_logs_tail",
      "mcp__legacy-sports-aws__aws_sso_status",
      "mcp__legacy-sports-android__*",
      "mcp__legacy-sports-browser__*",
      "mcp__legacy-sports-ci__*",
      "mcp__legacy-sports-db-admin__*",
      "mcp__legacy-sports-github__*",
      "mcp__legacy-sports-jira__*",
      "mcp__legacy-sports-make__*",
      "mcp__legacy-sports-nx__*",
      "mcp__worktree__worktree_branch",
      "mcp__worktree__worktree_checkout_file",
      "mcp__worktree__worktree_clean",
      "mcp__worktree__worktree_commit",
      "mcp__worktree__worktree_conflict_info",
      "mcp__worktree__worktree_diff",
      "mcp__worktree__worktree_guard",
      "mcp__worktree__worktree_list",
      "mcp__worktree__worktree_lock",
      "mcp__worktree__worktree_log",
      "mcp__worktree__worktree_ls_tree",
      "mcp__worktree__worktree_push",
      "mcp__worktree__worktree_rebase_continue",
      "mcp__worktree__worktree_rebase",
      "mcp__worktree__worktree_resolve_conflict",
      "mcp__worktree__worktree_set",
      "mcp__worktree__worktree_show_file",
      "mcp__worktree__worktree_show",
      "mcp__worktree__worktree_stabilize",
      "mcp__worktree__worktree_status",
      "mcp__worktree__worktree_rename_branch",
      "mcp__worktree__worktree_unlink",
      "mcp__worktree__worktree_unlock",
      "mcp__worktree__worktree_unstage",
      "mcp__stripe__*"
    ]
  },
  "enabledMcpjsonServers": [
    "legacy-sports-android",
    "legacy-sports-aws",
    "legacy-sports-browser",
    "legacy-sports-ci",
    "legacy-sports-db-admin",
    "legacy-sports-github",
    "legacy-sports-jira",
    "legacy-sports-make",
    "legacy-sports-nx",
    "worktree",
    "stripe"
  ],
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/check-incomplete-work.sh"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/delivery-gate.mjs",
            "windowsHide": true
          },
          {
            "type": "command",
            "command": ".claude/hooks/check-open-pr.sh"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/session-model-audit.mjs",
            "windowsHide": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/cleanup-worktree-junction.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/cleanup-worktree-symlink.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/setup-worktree-symlink.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/check-github-auth.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/check-workspace-auth.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/reset-tool-count.sh"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/session-model-audit.mjs",
            "windowsHide": true
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/read-compact-handoff.mjs",
            "windowsHide": true
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/write-compact-handoff.mjs",
            "windowsHide": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/log-tool-evidence.mjs",
            "windowsHide": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/guard-main-repo.sh"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/inject-skill-reminder.js",
            "windowsHide": true
          }
        ]
      },
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/guard-bash-mcp-first.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/guard-make-pc.sh",
            "windowsHide": true
          },
          {
            "type": "command",
            "command": "node .agents/hooks/enforce-background.mjs",
            "windowsHide": true
          }
        ]
      },
      {
        "matcher": "^Read$",
        "hooks": [
          {
            "type": "command",
            "command": "node .agents/hooks/block-tmp-polling.mjs",
            "windowsHide": true
          }
        ]
      },
      {
        "matcher": "^mcp__legacy-sports-make__make_run$",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/guard-make-pc.sh",
            "windowsHide": true
          }
        ]
      },
      {
        "matcher": "^(Bash|Edit|Write|NotebookEdit|mcp__legacy-sports-db__db_query|mcp__legacy-sports-db-admin__db_query)$",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/guard-risky-tools.mjs",
            "windowsHide": true
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/remind-compact.sh"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/budget-governor.mjs",
            "windowsHide": true
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true
  }
}
