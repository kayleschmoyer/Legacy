{
  "systemPrompt": "Software engineering agent in legacy-sports monorepo. Implement tickets To Do → merged PR autonomously, no narrating/hedging/summarizing. Pause only for irreversible actions or genuinely ambiguous interpretations.\n\n## Hard Rules\n- Never commit to `main`; work in worktree feature branches\n- Never embed secrets in Edit/Write/Bash args\n- One ticket = one worktree = one PR\n- Implement only what was asked — no speculative refactors, abstractions, or defensive error handling\n- Self-review every changed file before pushing\n- No `@ts-ignore` / `eslint-disable` — fix root causes\n- New GraphQL: `.graphql` + codegen, not inline `gql`\n- Never use `find`/`grep`/`cat`/`head`/`tail`/`cd` — prefer MCP tools, `git -C`, `make -C`\n- Pre-commit: `make_run(target:\"pc\")` only, never individual lint/typecheck/test\n- Never loop on `ci_view_run` / `github_view_pr` — events surface natively\n- pnpm 9.12.1 only\n- Commits must contain ticket key: `type(scope): message (LS-####)`\n\n## Done\nPR merged + Jira Done + MCP gap audit + tracking tasks complete. `make pc` passing or PR opened is not done.\n\n## Workflow\nRead `AGENTS.md` at session start before acting — source of truth for tools, env, workflow, architecture.\n\nSpawn a Plan sub-agent before coding anything beyond a trivial single-file change. No code until plan returns.\n\nSubagents don't inherit this context — include explicit tool/behavior instructions when spawning.\n\nOn `[COMPACT REMINDER]`, run `/compact` immediately then resume.",
  "env": {
    "ENABLE_TOOL_SEARCH": "true",
    "MCP_TIMEOUT": "10000"
  },
  "permissions": {
    "allow": [
      "mcp__legacy-sports-aws__aws_apigateway_inspect",
      "mcp__legacy-sports-aws__aws_lambda_status",
      "mcp__legacy-sports-aws__aws_logs_tail",
      "mcp__legacy-sports-aws__aws_sso_status",
      "mcp__legacy-sports-browser__*",
      "mcp__legacy-sports-ci__*",
      "mcp__legacy-sports-db__*",
      "mcp__legacy-sports-github__*",
      "mcp__legacy-sports-jira__*",
      "mcp__legacy-sports-make__*",
      "mcp__legacy-sports-nx__*",
      "mcp__worktree__worktree_checkout_file",
      "mcp__worktree__worktree_clean",
      "mcp__worktree__worktree_commit",
      "mcp__worktree__worktree_conflict_info",
      "mcp__worktree__worktree_diff",
      "mcp__worktree__worktree_guard",
      "mcp__worktree__worktree_list",
      "mcp__worktree__worktree_lock",
      "mcp__worktree__worktree_log",
      "mcp__worktree__worktree_ls_tree",
      "mcp__worktree__worktree_push",
      "mcp__worktree__worktree_rebase_continue",
      "mcp__worktree__worktree_rebase",
      "mcp__worktree__worktree_resolve_conflict",
      "mcp__worktree__worktree_set",
      "mcp__worktree__worktree_show_file",
      "mcp__worktree__worktree_show",
      "mcp__worktree__worktree_stabilize",
      "mcp__worktree__worktree_status",
      "mcp__worktree__worktree_rename_branch",
      "mcp__worktree__worktree_unlink",
      "mcp__worktree__worktree_unlock",
      "mcp__worktree__worktree_unstage"
    ]
  },
  "enabledMcpjsonServers": [
    "legacy-sports-aws",
    "legacy-sports-browser",
    "legacy-sports-ci",
    "legacy-sports-db",
    "legacy-sports-github",
    "legacy-sports-jira",
    "legacy-sports-make",
    "legacy-sports-nx",
    "worktree"
  ],
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/cleanup-worktree-junction.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/cleanup-worktree-symlink.sh"
          },
          {
            "type": "command",
            "command": "& '.claude/hooks/cleanup-worktree-symlink.ps1'",
            "shell": "powershell"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/setup-worktree-symlink.sh"
          },
          {
            "type": "command",
            "command": "& '.claude/hooks/setup-worktree-symlink.ps1'",
            "shell": "powershell"
          },
          {
            "type": "command",
            "command": ".claude/hooks/check-github-auth.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/check-workspace-auth.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/check-mcp-servers.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/reset-tool-count.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/guard-main-repo.sh"
          },
          {
            "type": "command",
            "command": "& '.claude/hooks/guard-main-repo.ps1'",
            "shell": "powershell"
          }
        ]
      },
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/guard-bash-mcp-first.sh"
          },
          {
            "type": "command",
            "command": "& '.claude/hooks/guard-bash-mcp-first.ps1'",
            "shell": "powershell"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/remind-compact.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true
  }
}
