{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "origin/main",
  "useDaemonProcess": true,
  "nxCloudAccessToken": "$(NX_CLOUD_ACCESS_TOKEN)",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/.eslintrc.json",
      "!{projectRoot}/eslint.config.js",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/jest.config.[jt]s",
      "!{projectRoot}/src/test-setup.[jt]s",
      "!{projectRoot}/test-setup.[jt]s"
    ],
    "sharedGlobals": ["{workspaceRoot}/.github/workflows/integration-build.yml"]
  },
  "parallel": 3,
  "plugins": [
    {
      "plugin": "@nx/jest/plugin",
      "options": {
        "targetName": "test"
      }
    },
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "lint"
      }
    },
    {
      "plugin": "@nx/vite/plugin",
      "options": {
        "buildTargetName": "build",
        "serveTargetName": "serve",
        "previewTargetName": "preview",
        "testTargetName": "test"
      }
    },
    {
      "plugin": "@nx/react/router-plugin",
      "options": {
        "buildTargetName": "build",
        "devTargetName": "dev",
        "startTargetName": "start",
        "watchDepsTargetName": "watch-deps",
        "buildDepsTargetName": "build-deps",
        "typecheckTargetName": "typecheck"
      }
    },
    {
      "plugin": "@nx/storybook/plugin",
      "options": {
        "buildStorybookTargetName": "build-storybook",
        "staticStorybookTargetName": "static-storybook",
        "serveStorybookTargetName": "storybook",
        "testStorybookTargetName": "test-storybook"
      }
    }
  ],
  "targetDefaults": {
    "@nx/esbuild:esbuild": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["default", "^default"]
    },
    "build:lambda": {
      "cache": true,
      "executor": "@legacy-sports/run-commands-windows",
      "inputs": ["production"],
      "outputs": ["{projectRoot}/dist"]
    },
    "package": {
      "cache": false,
      "dependsOn": ["build"],
      "executor": "@legacy-sports/run-commands-windows",
      "options": {}
    },
    "zip": {
      "cache": false,
      "dependsOn": ["build"],
      "executor": "@legacy-sports/run-commands-windows",
      "options": {}
    },
    "deploy": {
      "cache": false,
      "dependsOn": ["build"]
    },
    "deploy:plan": {
      "cache": false,
      "dependsOn": ["build"]
    },
    "validate:package-json": {
      "executor": "@legacy-sports/run-commands-windows",
      "options": {
        "command": "node scripts/validate-package-json-standards.js"
      }
    },
    "validate:workspace-deps": {
      "executor": "@legacy-sports/run-commands-windows",
      "options": {
        "command": "node scripts/validate-workspace-deps.js"
      }
    },
    "validate": {
      "dependsOn": ["validate:package-json", "validate:workspace-deps"]
    },
    "@nx/js:tsc": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"]
    },
    "lint": {
      "executor": "@legacy-sports/run-commands-windows",
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/.eslintrc.base.json",
        "{projectRoot}/.eslintrc.json",
        "{workspaceRoot}/tools/eslint-rules/**/*",
        {
          "externalDependencies": ["eslint"]
        }
      ],
      "outputs": ["{options.outputFile}"],
      "options": {
        "command": "eslint . --max-warnings=0"
      },
      "configurations": {
        "dry-run": {
          "command": "eslint . --fix-dry-run"
        }
      }
    },
    "format": {
      "executor": "@legacy-sports/run-commands-windows",
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/.prettierrc",
        "{workspaceRoot}/prettier.config.js",
        "{projectRoot}/.prettierrc"
      ],
      "outputs": [],
      "options": {
        "command": "prettier --write ."
      },
      "configurations": {
        "check": {
          "command": "prettier --check ."
        }
      }
    },
    "typecheck": {
      "executor": "@legacy-sports/run-commands-windows",
      "cache": true,
      "inputs": [
        "production",
        "^production",
        {
          "externalDependencies": ["typescript"]
        }
      ],
      "options": {
        "command": "tsc --noEmit"
      },
      "parallelism": false
    },
    "build-android": {
      "cache": true,
      "inputs": [
        "default",
        "^production",
        "{projectRoot}/android/**/*",
        "{projectRoot}/index.js",
        "{projectRoot}/metro.config.js",
        "{projectRoot}/babel.config.js",
        "{workspaceRoot}/android/**/*",
        "{workspaceRoot}/app.json",
        "{workspaceRoot}/babel.config.json",
        {
          "externalDependencies": ["gradle", "java"]
        }
      ],
      "outputs": [
        "{projectRoot}/android/app/build/outputs/apk",
        "{projectRoot}/android/app/build/intermediates/merged_assets"
      ]
    },
    "build-android-debug": {
      "cache": true,
      "inputs": [
        "default",
        "^production",
        "{projectRoot}/android/**/*",
        "{projectRoot}/index.js",
        "{projectRoot}/metro.config.js",
        "{projectRoot}/babel.config.js",
        "{workspaceRoot}/android/**/*",
        "{workspaceRoot}/app.json",
        "{workspaceRoot}/babel.config.json",
        {
          "externalDependencies": ["gradle", "java"]
        }
      ],
      "outputs": [
        "{projectRoot}/android/app/build/outputs/apk",
        "{projectRoot}/android/app/build/intermediates/merged_assets"
      ]
    }
  },
  "generators": {
    "@nx/react": {
      "application": {
        "babel": true,
        "style": "css",
        "linter": "eslint",
        "bundler": "vite"
      },
      "component": {
        "style": "css"
      },
      "library": {
        "style": "css",
        "linter": "eslint",
        "unitTestRunner": "none"
      }
    }
  }
}
