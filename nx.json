{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "origin/main",
  "useDaemonProcess": true,
  "tasksRunnerOptions": {
    "default": {
      "runner": "nx/tasks-runners/default",
      "options": {
        "env": {}
      }
    }
  },
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/eslint.config.mjs",
      "!{projectRoot}/eslint.config.js",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/jest.config.[jt]s",
      "!{projectRoot}/src/test-setup.[jt]s",
      "!{projectRoot}/test-setup.[jt]s"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/nx.json"
    ]
  },
  "parallel": 5,
  "plugins": [
    {
      "plugin": "@nx/jest/plugin",
      "options": {
        "targetName": "test"
      },
      "exclude": ["package.json"]
    },
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "lint"
      },
      "exclude": [
        "package.json",
        "tools/mcp/aws-server/**",
        "tools/mcp/browser-server/**",
        "tools/mcp/db-admin-server/**",
        "tools/mcp/dev-process-server/**",
        "tools/mcp/jira-server/**",
        "tools/mcp/nx-server/**",
        "tools/mcp/rollbar-server/**",
        "tools/jira-sync/**",
        "tools/rollbar-jira-reconcile/**"
      ]
    },
    {
      "plugin": "@nx/storybook/plugin",
      "options": {
        "buildStorybookTargetName": "build-storybook",
        "staticStorybookTargetName": "static-storybook",
        "serveStorybookTargetName": "storybook",
        "testStorybookTargetName": "test-storybook"
      }
    }
  ],
  "targetDefaults": {
    "@nx/esbuild:esbuild": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"]
    },
    "@nx/vite:build": {
      "cache": true,
      "inputs": ["production", "^production"],
      "outputs": ["{options.outputPath}"]
    },
    "@nx/storybook:build": {
      "cache": true,
      "inputs": ["production", "^production"]
    },
    "package": {
      "cache": false,
      "dependsOn": ["build"],
      "executor": "nx:run-commands",
      "options": {}
    },
    "zip": {
      "cache": false,
      "dependsOn": ["build"],
      "executor": "nx:run-commands",
      "options": {}
    },
    "deploy": {
      "cache": false,
      "dependsOn": ["build"]
    },
    "deploy:plan": {
      "cache": false,
      "dependsOn": ["build"]
    },
    "validate:package-json": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/package.json",
        "{workspaceRoot}/apps/*/package.json",
        "{workspaceRoot}/lib/*/package.json",
        "{workspaceRoot}/lambdas/*/package.json",
        "{workspaceRoot}/tools/*/package.json",
        "{workspaceRoot}/scripts/validate-package-json-standards.js"
      ],
      "options": {
        "command": "node scripts/validate-package-json-standards.js"
      }
    },
    "validate:workspace-deps": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/package.json",
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/apps/*/package.json",
        "{workspaceRoot}/lib/*/package.json",
        "{workspaceRoot}/lambdas/*/package.json",
        "{workspaceRoot}/tools/*/package.json",
        "{workspaceRoot}/scripts/validate-workspace-deps.js"
      ],
      "options": {
        "command": "node scripts/validate-workspace-deps.js"
      }
    },
    "validate": {
      "dependsOn": ["validate:package-json", "validate:workspace-deps"]
    },
    "@nx/js:tsc": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"]
    },
    "lint": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/eslint.config.mjs",
        "{workspaceRoot}/tools/eslint-rules/**/*",
        {
          "externalDependencies": ["eslint"]
        }
      ],
      "outputs": ["{options.outputFile}"],
      "options": {
        "command": "eslint . --max-warnings=0"
      },
      "configurations": {
        "dry-run": {
          "command": "eslint . --fix-dry-run"
        }
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/.prettierrc",
        "{workspaceRoot}/.prettierignore",
        "{projectRoot}/.prettierrc"
      ],
      "outputs": [],
      "options": {
        "command": "prettier --write ."
      },
      "configurations": {
        "check": {
          "command": "prettier --check ."
        }
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "production",
        "^production",
        {
          "externalDependencies": ["typescript"]
        }
      ],
      "options": {
        "command": "tsc --noEmit -p tsconfig.lib.json",
        "cwd": "{projectRoot}"
      }
    },
    "test": {
      "cache": true,
      "inputs": ["default", "^production"],
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "passWithNoTests": true
      },
      "configurations": {
        "ci": {
          "ci": true,
          "coverageReporters": ["text"]
        }
      }
    },
    "build-android": {
      "cache": true,
      "inputs": [
        "default",
        "^production",
        "{projectRoot}/app.json",
        "{projectRoot}/index.js",
        "{projectRoot}/metro.config.js",
        "{projectRoot}/.babelrc.js",
        "{workspaceRoot}/app.json",
        "{workspaceRoot}/babel.config.json",
        {
          "externalDependencies": ["gradle", "java"]
        }
      ],
      "outputs": ["{projectRoot}/android/app/build/outputs/apk"]
    },
    "build-android-debug": {
      "cache": true,
      "inputs": [
        "default",
        "^production",
        "{projectRoot}/app.json",
        "{projectRoot}/index.js",
        "{projectRoot}/metro.config.js",
        "{projectRoot}/.babelrc.js",
        "{workspaceRoot}/app.json",
        "{workspaceRoot}/babel.config.json",
        {
          "externalDependencies": ["gradle", "java"]
        }
      ],
      "outputs": ["{projectRoot}/android/app/build/outputs/apk"]
    }
  },
  "generators": {
    "@nx/react": {
      "application": {
        "babel": true,
        "style": "css",
        "linter": "eslint",
        "bundler": "vite"
      },
      "component": {
        "style": "css"
      },
      "library": {
        "style": "css",
        "linter": "eslint",
        "unitTestRunner": "none"
      }
    }
  },
  "analytics": false
}
