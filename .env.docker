# =============================================================================
# Legacy Sports — Docker Override Variables
# =============================================================================
# Loaded AFTER .env by docker-compose (later file wins).
# Contains only the values that need to differ from .env for local Docker.
#
# Layer order in docker-compose.yml:
#   env_file:
#     - .env         ← real synced secrets (gitignored)
#     - .env.docker  ← docker-specific overrides (this file, committed)
#
# Auth secrets (JWT_SECRET, COOKIE_SECRET, etc.) are defined here with dev
# values so the stack works without AWS. Production never uses Docker Compose.
# =============================================================================

# ---------------------------------------------------------------------------
# Database — replace AWS RDS with the local postgres container
# ---------------------------------------------------------------------------
USE_LOCAL_CREDENTIALS=true
DB_HOST=postgres:5432
DB_USER=legacy_sports
DB_PASSWORD=legacy_sports_dev
DB_NAME=legacy_sports_dev
DB_HOST_DIRECT=postgres

# Clear AWS-specific DB settings
DB_SECRET_NAME=
DB_CREDS_PATH=
# No SSL cert needed for local postgres container
DB_CERT_PATH=

# Drizzle-compatible URL (used by db:migrate and db:psql scripts)
DATABASE_URL=postgresql://legacy_sports:legacy_sports_dev@postgres:5432/legacy_sports_dev

# ---------------------------------------------------------------------------
# Service URLs — point browser (localhost) to locally exposed docker ports
# ---------------------------------------------------------------------------
VITE_GRAPHQL_HOST=http://localhost:5000/graphql
VITE_OAUTH_PROXY_URL=http://localhost:5001/oauth

# Internal container-to-container API base URL
INTERNAL_API_BASE_URL=http://graphql:5000

# ---------------------------------------------------------------------------
# SQS — cleared; lambdas degrade gracefully without a queue
# Add ElasticMQ as a compose service if you need local queue processing.
# ---------------------------------------------------------------------------
SQS_QUEUE_URL=
SQS_LOAD_SEASON_STATS_URL=
SQS_LOAD_GAME_STATS_URL=
SQS_AUTOMATIC_DRAFTS_URL=
SQS_SELECT_GAME_URL=

# ---------------------------------------------------------------------------
# WebSocket — not wired locally
# ---------------------------------------------------------------------------
VITE_WEBSOCKET_URL=

# ---------------------------------------------------------------------------
# Auth secrets — dev values committed here so the stack works without AWS.
# Docker Compose loads .env.docker AFTER .env, so these are the final values.
# Production never uses Docker Compose, so these never reach production.
# NEVER use these values outside of local Docker.
# ---------------------------------------------------------------------------
JWT_SECRET=dev-jwt-secret-not-for-production
COOKIE_SECRET=dev-cookie-secret-not-for-production
# Google OAuth is disabled locally — use /local/login or /local/register instead
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:5001/oauth/google/callback
# Allow the local web app to make credentialed OAuth requests.
# Required since dev.ts no longer uses the wildcard-CORS Express middleware.
CORS_ALLOWED_ORIGINS=http://localhost:4200
