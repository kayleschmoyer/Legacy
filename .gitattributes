# Force LF line endings for all text files (consistent across platforms)
* text=auto eol=lf
# Explicitly declare text files you want to always be normalized and converted
# to native line endings on checkout.
*.js text
*.ts text
*.tsx text
*.jsx text
*.json text
*.md text
*.yml text
*.yaml text
*.xml text
*.html text
*.css text
*.scss text
*.less text
# Declare files that will always have lf line endings on checkout.
*.bat text eol=lf
*.cmd text eol=lf
# Declare files that will always have LF line endings on checkout.
*.sh text eol=lf
# Denote all files that are truly binary and should not be modified.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.tar.gz binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
# Git LFS - large binary assets too big for regular git
resources/dev-seed.dump filter=lfs diff=lfs merge=lfs -text
