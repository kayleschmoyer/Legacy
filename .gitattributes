# Force LF line endings for all text files (consistent across platforms)
* text=auto eol=lf
# Explicitly declare text files you want to always be normalized and converted
# to native line endings on checkout.
*.js text
*.ts text
*.tsx text
*.jsx text
*.json text
*.md text
*.yml text
*.yaml text
*.xml text
*.html text
*.css text
*.scss text
*.less text
# Declare files that will always have lf line endings on checkout.
*.bat text eol=lf
*.cmd text eol=lf
# Declare files that will always have LF line endings on checkout.
*.sh text eol=lf
# Denote all files that are truly binary and should not be modified.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.tar.gz binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

# Generated MCP API reference (LS-10150): every MCP-touching PR rewrites this
# file wholesale from tools/mcp/, so two PRs in flight always conflict on it
# even when neither changed anything the other cares about. `merge=ours`
# (driver registered in scripts/setup-git-merge-drivers.js, run from
# postinstall) auto-resolves instead of conflicting; mcp-api-reference-sync.sh
# still fails CI if the checked-in file drifts from a fresh regeneration, so
# a stale "ours" pick can never land silently — see docs/mcp/api-reference.html.
docs/mcp/api-reference.html merge=mcp-generated-ours
