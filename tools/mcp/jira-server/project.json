{
  "name": "mcp-jira-server",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "tools/mcp/jira-server/src",
  "projectType": "application",
  "tags": ["scope:tool", "platform:node"],
  "targets": {
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/tools/mcp/jira-server"],
      "options": {
        "jestConfig": "tools/mcp/jira-server/jest.config.ts"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p tools/mcp/jira-server/tsconfig.json"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/dist"],
      "dependsOn": ["^build"],
      "options": {
        "command": "vite build",
        "cwd": "tools/mcp/jira-server"
      },
      "configurations": {
        "production": {
          "command": "vite build --mode production"
        }
      }
    }
  }
}
