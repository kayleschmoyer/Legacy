{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "declaration": true
  },
  "include": ["src/**/*.ts", "../github-server/src/**/*.ts"],
  "exclude": [
    "../github-server/src/**/*.spec.ts",
    "../github-server/src/**/*.test.ts"
  ]
}
