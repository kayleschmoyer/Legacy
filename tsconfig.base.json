{
  "compileOnSave": false,
  "compilerOptions": {
    "strict": true,
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@legacy-sports/analytics": ["lib/analytics/src/index.ts"],
      "@legacy-sports/api": ["lib/api/src/index.ts"],
      "@legacy-sports/aws-utils": ["lib/aws-utils/src/index.ts"],
      "@legacy-sports/bref-client": ["lib/bref-client/src/index.ts"],
      "@legacy-sports/codegen-base": ["lib/codegen/codegen.base.ts"],
      "@legacy-sports/data-loaders": ["lib/data-loaders/src/index.ts"],
      "@legacy-sports/design-tokens": ["lib/design-tokens/src/index.ts"],
      "@legacy-sports/db-client": ["lib/db-client/src/index.ts"],
      "@legacy-sports/db-client/src/*": ["lib/db-client/src/*"],
      "@legacy-sports/env-utilities": ["lib/env-utilities/src/index.ts"],
      "@legacy-sports/logging": ["lib/logging/src/index.ts"],
      "@legacy-sports/logging/server": ["lib/logging/src/server.ts"],
      "@legacy-sports/mlb-client": ["lib/mlb-client/src/index.ts"],
      "@legacy-sports/pfr-client": ["lib/pfr-client/src/index.ts"],
      "@legacy-sports/narrative": ["lib/narrative/src/index.ts"],
      "@legacy-sports/rollbar": ["lib/rollbar/src/index.ts"],
      "@legacy-sports/rollbar/native": ["lib/rollbar/src/native.ts"],
      "@legacy-sports/rollbar/web": ["lib/rollbar/src/web.ts"],
      "@legacy-sports/scheduling": ["lib/scheduling/src/index.ts"],
      "@legacy-sports/scoring": ["lib/scoring/src/index.ts"],
      "@legacy-sports/shared-components": [
        "lib/shared-components/src/index.ts"
      ],
      "@legacy-sports/shared-components/auth": [
        "lib/shared-components/src/entry/auth.ts"
      ],
      "@legacy-sports/shared-components/chat": [
        "lib/shared-components/src/entry/chat.ts"
      ],
      "@legacy-sports/shared-components/commissioner": [
        "lib/shared-components/src/entry/commissioner.ts"
      ],
      "@legacy-sports/shared-components/draft": [
        "lib/shared-components/src/entry/draft.ts"
      ],
      "@legacy-sports/shared-components/elite-draft": [
        "lib/shared-components/src/entry/elite-draft.ts"
      ],
      "@legacy-sports/shared-components/icons": [
        "lib/shared-components/src/entry/icons.ts"
      ],
      "@legacy-sports/shared-components/leagues": [
        "lib/shared-components/src/entry/leagues.ts"
      ],
      "@legacy-sports/shared-components/matchup": [
        "lib/shared-components/src/entry/matchup.ts"
      ],
      "@legacy-sports/shared-components/players": [
        "lib/shared-components/src/entry/players.ts"
      ],
      "@legacy-sports/shared-components/roster": [
        "lib/shared-components/src/entry/roster.ts"
      ],
      "@legacy-sports/shared-components/season-draft": [
        "lib/shared-components/src/entry/season-draft.ts"
      ],
      "@legacy-sports/shared-components/sports": [
        "lib/shared-components/src/entry/sports.ts"
      ],
      "@legacy-sports/shared-components/stats": [
        "lib/shared-components/src/entry/stats.ts"
      ],
      "@legacy-sports/shared-components/ui": [
        "lib/shared-components/src/entry/ui.ts"
      ],
      "@legacy-sports/shared-components/utils": [
        "lib/shared-components/src/entry/utils.ts"
      ],
      "@legacy-sports/tamagui-config": ["lib/tamagui-config/src/index.ts"],
      "@legacy-sports/test-fixtures": ["lib/test-fixtures/src/index.ts"],
      "@legacy-sports/ui-abstractions": ["lib/ui-abstractions/src/index.ts"],
      "@legacy-sports/utils": ["lib/utils/src/index.ts"],
      "@legacy-sports/utils/node": ["lib/utils/src/node.ts"],
      "@legacy-sports/websocket-client": ["lib/websocket-client/src/index.ts"],
      "__PLATFORM_COMPONENTS__": [
        "lib/shared-components/src/platform-components/web/index.ts"
      ]
    }
  },
  "exclude": [
    "node_modules",
    ".modules-pool",
    "tmp",
    "android/**/*",
    "terraform/**/*",
    ".nx/**/*",
    "dist/**/*",
    "playwright-report/**/*",
    "test-results/**/*",
    "resources/**/*",
    "static/**/*"
  ]
}
