%% Spine detail: 6 phases + exit gates
%% Source of truth for diagrams/spine-detail.svg (regenerate with `make diagrams`)
flowchart TB
    Start([Trigger from entrypoint])

    Start --> P1
    subgraph P1["Phase 1: Frame"]
        P1A["Read trigger end-to-end"]
        P1B["Restate problem\n& acceptance criteria"]
        P1C["Identify out-of-scope items"]
        P1D["Assign risk tier"]
        P1E["Repro report\n(investigation entrypoints)"]
        P1A --> P1B --> P1C --> P1D --> P1E
    end

    P1 --> G1{"Risk tier assigned?\nTrigger linked?\nRepro attached (if investigation)?"}
    G1 -->|No| P1
    G1 -->|Yes| P2

    subgraph P2["Phase 2: Design"]
        P2A["RFC if Medium+\n(skip for Critical-tier incidents)"]
        P2B["ADR for architectural decisions"]
        P2C["Shape + critique\n(UI work only, before coding)"]
        P2D["Test plan written"]
        P2E["Touch-map identified"]
        P2A --> P2B --> P2C --> P2D --> P2E
    end

    P2 --> G2{"RFC accepted?\nTest plan written?"}
    G2 -->|No| P2
    G2 -->|Yes| P3

    subgraph P3["Phase 3: Implement"]
        P3A["Vertical slices"]
        P3B["Green tree per commit"]
        P3C["Docs alongside code"]
        P3A --> P3B --> P3C
    end

    P3 --> G3{"All planned changes coded?"}
    G3 -->|No| P3
    G3 -->|Yes| P4

    subgraph P4["Phase 4: Verify"]
        P4A["make pc green"]
        P4B["Manual exercise"]
        P4C["Determinism check\n(new E2E/integration tests)"]
        P4D["Test plan coverage"]
        P4A --> P4B --> P4C --> P4D
    end

    P4 --> G4{"All gates green?"}
    G4 -->|No| P4
    G4 -->|Yes| P5

    subgraph P5["Phase 5: Document"]
        P5A["Apply touch-map"]
        P5B["Archive RFC / ADR\n(promote drafts to numbered)"]
        P5C["Postmortem\n(if Critical tier or incident)"]
        P5D["Update dev-process README\n(if process changed)"]
        P5A --> P5B --> P5C --> P5D
    end

    P5 --> G5{"All docs current?"}
    G5 -->|No| P5
    G5 -->|Yes| P6

    subgraph P6["Phase 6: Handoff"]
        P6A["Self-review"]
        P6B["Open PR draft\nApply agent-in-progress label"]
        P6C["Mark ready for review"]
        P6D["Bot-PR contract\n(Cycles 1/2/3)"]
        P6E["Merge"]
        P6F["Verify Jira → Done\nClose tracking tasks"]
        P6A --> P6B --> P6C --> P6D --> P6E --> P6F
    end

    P6 --> G6{"PR merged?\nJira Done?\nAudit run (or skipped if shallow)?\nTasks closed?"}
    G6 -->|No| P6
    G6 -->|Yes| End

    End([Task complete])
