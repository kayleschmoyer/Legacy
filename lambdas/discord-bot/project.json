{
  "name": "discord-bot",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "lambdas/discord-bot/src",
  "projectType": "application",
  "tags": ["lambda", "platform:node", "scope:lambda", "type:api"],
  "targets": {
    "typecheck": {
      "options": {
        "command": "tsc --noEmit -p tsconfig.app.json"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/dist"],
      "dependsOn": ["^build"],
      "options": {
        "command": "vite build",
        "cwd": "lambdas/discord-bot"
      },
      "configurations": {
        "development": {
          "command": "vite build --mode development"
        },
        "production": {
          "command": "vite build --mode production"
        }
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "../../scripts/deploy-lambda.ps1 -FunctionName discord-bot",
        "cwd": "lambdas/discord-bot"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx src/dev.ts",
        "cwd": "lambdas/discord-bot"
      }
    }
  }
}
