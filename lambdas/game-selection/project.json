{
  "name": "game-selection",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "lambdas/game-selection/src",
  "projectType": "application",
  "tags": ["lambda", "platform:node", "scope:lambda", "type:api"],
  "targets": {
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "lambdas/game-selection/jest.config.ts",
        "passWithNoTests": false
      }
    },
    "typecheck": {
      "options": {
        "command": "tsc --noEmit -p tsconfig.app.json"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/dist"],
      "dependsOn": ["^build"],
      "options": {
        "command": "vite build",
        "cwd": "lambdas/game-selection"
      },
      "configurations": {
        "development": {
          "command": "vite build --mode development"
        },
        "production": {
          "command": "vite build --mode production"
        }
      }
    },
    "package": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "echo 'Legacy serverless package command. Use nx deploy game-selection instead.'",
        "cwd": "lambdas/game-selection"
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "dependsOn": ["package"],
      "options": {
        "commands": [
          "terraform -chdir=terraform/main apply -target=aws_lambda_function.game_selection -target=aws_api_gateway_resource.game_selection -target=aws_api_gateway_resource.game_selection_paths -target=aws_api_gateway_method.game_selection_options -target=aws_api_gateway_method.game_selection_any -target=aws_api_gateway_integration.game_selection_options -target=aws_api_gateway_integration.game_selection_any -target=aws_lambda_permission.game_selection_api_gateway -auto-approve",
          "terraform -chdir=terraform/main apply -target=aws_api_gateway_deployment.main -auto-approve"
        ],
        "parallel": false,
        "cwd": "."
      }
    },
    "deploy:plan": {
      "executor": "nx:run-commands",
      "dependsOn": ["package"],
      "options": {
        "commands": [
          "echo '\ud83d\udd0d Validating Terraform configuration for game-selection lambda...'",
          "terraform -chdir=terraform/main fmt -check || (echo '\u26a0\ufe0f  Terraform formatting issues found' && terraform -chdir=terraform/main fmt)",
          "terraform -chdir=terraform/main validate || echo '\u26a0\ufe0f  Terraform validation failed - this may be expected in CI without full AWS context'",
          "terraform -chdir=terraform/main plan -target=aws_lambda_function.game_selection -target=aws_api_gateway_resource.game_selection -target=aws_api_gateway_resource.game_selection_paths -target=aws_api_gateway_method.game_selection_options -target=aws_api_gateway_method.game_selection_any -target=aws_api_gateway_integration.game_selection_options -target=aws_api_gateway_integration.game_selection_any -target=aws_lambda_permission.game_selection_api_gateway 2>&1 || echo '\u26a0\ufe0f  Terraform plan failed - this is expected in CI without terraform state and AWS credentials'"
        ],
        "parallel": false,
        "cwd": "."
      }
    },
    "test-endpoint": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "curl -X GET \"https://$(terraform -chdir=terraform/main output -raw api_gateway_url)/games/health\" -H \"Content-Type: application/json\""
        ],
        "parallel": false,
        "cwd": "."
      }
    },
    "logs": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "aws logs tail /aws/lambda/legacy-sports-dev-game-selection --follow --region us-east-1"
        ],
        "parallel": false,
        "cwd": "."
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx src/dev.ts",
        "cwd": "lambdas/game-selection"
      }
    }
  }
}
