{
  "name": "image-upload",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "lambdas/image-upload",
  "projectType": "application",
  "tags": ["lambda", "platform:node", "scope:lambda", "type:upload"],
  "targets": {
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "cache": true,
      "options": {
        "jestConfig": "lambdas/image-upload/jest.config.ts"
      }
    },
    "typecheck": {
      "options": {
        "command": "tsc --noEmit -p tsconfig.app.json"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/dist"],
      "dependsOn": ["^build"],
      "options": {
        "command": "vite build",
        "cwd": "lambdas/image-upload"
      },
      "configurations": {
        "development": {
          "command": "vite build --mode development"
        },
        "production": {
          "command": "vite build --mode production"
        }
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "../../scripts/deploy-lambda.ps1 -FunctionName image-upload",
        "cwd": "lambdas/image-upload"
      }
    },
    "deploy:plan": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "commands": [
          "echo '🔍 Validating Terraform configuration for image-upload lambda...'",
          "terraform -chdir=terraform/main fmt -check || (echo '⚠️  Terraform formatting issues found' && terraform -chdir=terraform/main fmt)",
          "terraform -chdir=terraform/main validate || echo '⚠️  Terraform validation failed'",
          "terraform -chdir=terraform/main plan -target=aws_lambda_function.image_upload 2>&1 || echo '⚠️  Terraform plan failed - expected without state/credentials'"
        ],
        "parallel": false,
        "cwd": "."
      }
    },
    "deploy:apply": {
      "executor": "nx:run-commands",
      "options": {
        "command": "terraform -chdir=terraform/main apply -target=aws_lambda_function.image_upload -auto-approve",
        "cwd": "."
      }
    },
    "logs": {
      "executor": "nx:run-commands",
      "options": {
        "command": "aws logs tail \"/aws/lambda/legacy-sports-dev-image-upload\" --follow",
        "cwd": "."
      }
    }
  }
}
