{
  "name": "notifications-lambda",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "lambdas/notifications",
  "projectType": "application",
  "tags": [
    "lambda",
    "platform:node",
    "scope:lambda",
    "type:api"
  ],
  "targets": {
    "build": {
      "extends": "build:lambda",
      "options": {
        "command": "vite build",
        "cwd": "lambdas/notifications"
      },
      "configurations": {
        "development": {
          "command": "vite build --mode development"
        },
        "production": {
          "command": "vite build --mode production"
        }
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "jestConfig": "lambdas/notifications/jest.config.ts",
        "passWithNoTests": true
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p tsconfig.app.json",
        "cwd": "lambdas/notifications"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["lambdas/notifications/**/*.ts"]
      }
    }
  }
}
