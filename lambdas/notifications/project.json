{
  "name": "notifications",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "lambdas/notifications/src",
  "projectType": "application",
  "tags": ["lambda", "platform:node", "scope:lambda", "type:api"],
  "targets": {
    "typecheck": {
      "options": {
        "command": "tsc --noEmit -p tsconfig.app.json"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/dist"],
      "dependsOn": ["^build"],
      "options": {
        "command": "vite build",
        "cwd": "lambdas/notifications"
      },
      "configurations": {
        "development": {
          "command": "vite build --mode development"
        },
        "production": {
          "command": "vite build --mode production"
        }
      }
    },
    "package": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "commands": [
          "cd lambdas/notifications/dist && (command -v zip > /dev/null 2>&1 && zip -j index.js.zip index.js || echo 'Warning: zip utility not found - skipping packaging.')"
        ],
        "parallel": false
      },
      "configurations": {
        "production": {
          "commands": [
            "cd lambdas/notifications/dist && zip -j index.js.zip index.js"
          ]
        }
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "dependsOn": ["package"],
      "options": {
        "commands": [
          "terraform -chdir=terraform/main apply -target=aws_lambda_function.notifications -auto-approve",
          "terraform -chdir=terraform/main apply -target=aws_sqs_queue.notifications_queue -auto-approve"
        ],
        "parallel": false,
        "cwd": "."
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx src/dev.ts",
        "cwd": "lambdas/notifications"
      }
    },
    "logs": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "aws logs tail /aws/lambda/legacy-sports-dev-notifications --follow --region us-east-1"
        ],
        "parallel": false,
        "cwd": "."
      }
    }
  }
}
