{
  "name": "db",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "lambdas/db",
  "projectType": "application",
  "tags": ["platform:node", "scope:lambda", "type:api"],
  "// targets": "to see all targets run: nx show project db --web",
  "targets": {
    "typecheck": {
      "options": {
        "command": "tsc --noEmit -p tsconfig.app.json"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/dist"],
      "dependsOn": ["^build"],
      "options": {
        "command": "vite build",
        "cwd": "lambdas/db"
      },
      "configurations": {
        "development": {
          "command": "vite build --mode development"
        },
        "production": {
          "command": "vite build --mode production"
        }
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "../../scripts/deploy-lambda.sh graphql",
        "cwd": "lambdas/db"
      }
    },
    "deploy:plan": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "commands": [
          "echo '🔍 Validating Terraform configuration for GraphQL lambda...'",
          "cd ../../terraform && terraform fmt -check || (echo '⚠️  Terraform formatting issues found' && terraform fmt)",
          "cd ../../terraform && terraform validate || echo '⚠️  Terraform validation failed - this may be expected in CI without full AWS context'",
          "cd ../../terraform && (terraform plan -target=aws_lambda_function.graphql 2>&1 || echo '⚠️  Terraform plan failed - this is expected in CI without terraform state and AWS credentials')"
        ],
        "parallel": false,
        "cwd": "lambdas/db"
      }
    },
    "deploy:apply": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cd ../../terraform && terraform apply -target=aws_lambda_function.graphql -auto-approve",
        "cwd": "lambdas/db"
      }
    },
    "package": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "echo 'Legacy serverless package command. Use nx deploy db instead.'",
        "cwd": "lambdas/db"
      }
    },
    "logs": {
      "executor": "nx:run-commands",
      "options": {
        "command": "aws logs tail \"/aws/lambda/legacy-sports-dev-graphql\" --follow",
        "cwd": "terraform"
      }
    },
    "test-endpoint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "curl -s -X POST https://api.legacy-fantasy.com/graphql -H 'Content-Type: application/json' -d '{\"query\": \"{ hello }\"}'"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx watch --tsconfig ../../tsconfig.base.json src/dev.ts",
        "cwd": "lambdas/db"
      }
    },
    "test:integration": {
      "executor": "@nx/jest:jest",
      "cache": true,
      "inputs": ["default", "^production"],
      "outputs": ["{workspaceRoot}/coverage/lambdas/db-integration"],
      "options": {
        "jestConfig": "lambdas/db/jest.integration.config.ts",
        "testPathPattern": "\\.integration\\.spec\\.ts$",
        "runInBand": true
      }
    },
    "test:integration:watch": {
      "executor": "@nx/jest:jest",
      "options": {
        "jestConfig": "lambdas/db/jest.integration.config.ts",
        "testPathPattern": "\\.integration\\.spec\\.ts$",
        "watch": true,
        "runInBand": true
      }
    },
    "print-schema": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx --tsconfig ../../tsconfig.base.json scripts/print-schema.ts",
        "cwd": "lambdas/db"
      }
    }
  }
}
