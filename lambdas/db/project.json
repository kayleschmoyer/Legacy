{
  "name": "db",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "lambdas/db",
  "projectType": "application",
  "tags": [],
  "// targets": "to see all targets run: nx show project db --web",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "vite build",
        "cwd": "lambdas/db"
      },
      "configurations": {
        "development": {
          "command": "vite build --mode development"
        },
        "production": {
          "command": "vite build --mode production"
        }
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "../../scripts/deploy-lambda.sh graphql",
        "cwd": "lambdas/db"
      }
    },
    "deploy:plan": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "cd ../../terraform && terraform plan -target=aws_lambda_function.graphql",
        "cwd": "lambdas/db"
      }
    },
    "deploy:apply": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cd ../../terraform && terraform apply -target=aws_lambda_function.graphql -auto-approve",
        "cwd": "lambdas/db"
      }
    },
    "package": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "echo 'Legacy serverless package command. Use nx deploy db instead.'",
        "cwd": "lambdas/db"
      }
    },
    "logs": {
      "executor": "nx:run-commands",
      "options": {
        "command": "aws logs tail \"/aws/lambda/legacy-sports-dev-graphql\" --follow",
        "cwd": "terraform"
      }
    },
    "test-endpoint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "powershell -Command \"$headers = @{'Content-Type' = 'application/json'}; $body = '{\\\"query\\\": \\\"{ hello }\\\"}'; $response = Invoke-RestMethod -Uri 'https://u65oy98s9d.execute-api.us-east-1.amazonaws.com/dev/graphql' -Method POST -Headers $headers -Body $body; $response | ConvertTo-Json\"",
        "cwd": "terraform"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx --tsconfig ../../tsconfig.base.json src/dev.ts",
        "cwd": "lambdas/db"
      }
    }
  }
}
