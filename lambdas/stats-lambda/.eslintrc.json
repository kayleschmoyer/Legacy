{
  "extends": ["../../.eslintrc.json"],
  "ignorePatterns": [
    "!**/*",
    ".expo",
    "web-build",
    "cache",
    "dist",
    "node_modules/**/*",
    "**/node_modules/**",
    ".pnpm/**"
  ],
  "overrides": [
    {
      "files": ["*.ts", "*.tsx"],
      "parserOptions": {
        "project": ["tsconfig.*?.json"]
      },
      "rules": {}
    },
    {
      "files": ["*.js", "*.jsx"],
      "rules": {}
    }
  ]
}
