{
  "name": "stats-lambda",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "lambdas/stats-lambda",
  "projectType": "application",
  "tags": ["lambda", "platform:node", "scope:lambda", "type:api"],
  "// targets": "to see all targets run: nx show project stats-lambda --web",
  "targets": {
    "typecheck": {
      "options": {
        "command": "tsc --noEmit -p tsconfig.app.json"
      }
    },
    "build": {
      "extends": "build:lambda",
      "options": {
        "command": "vite build",
        "cwd": "lambdas/stats-lambda"
      },
      "configurations": {
        "development": {
          "command": "vite build --mode development"
        },
        "production": {
          "command": "vite build --mode production"
        }
      }
    },
    "package": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "commands": [
          "cd lambdas/stats-lambda/dist && (command -v zip > /dev/null 2>&1 && zip -j index.js.zip index.js || echo 'Warning: zip utility not found - skipping packaging. This is expected in DTE environments.')"
        ],
        "parallel": false
      },
      "configurations": {
        "production": {
          "commands": [
            "cd lambdas/stats-lambda/dist && zip -j index.js.zip index.js"
          ]
        }
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "../../scripts/deploy-lambda.sh stats",
        "cwd": "lambdas/stats-lambda"
      }
    },
    "deploy:plan": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "commands": [
          "echo '🔍 Validating Terraform configuration for stats lambda...'",
          "cd ../../terraform && terraform fmt -check || (echo '⚠️  Terraform formatting issues found' && terraform fmt)",
          "cd ../../terraform && terraform validate || echo '⚠️  Terraform validation failed - this may be expected in CI without full AWS context'",
          "cd ../../terraform && (terraform plan -target=aws_lambda_function.stats 2>&1 || echo '⚠️  Terraform plan failed - this is expected in CI without terraform state and AWS credentials')"
        ],
        "parallel": false,
        "cwd": "lambdas/stats-lambda"
      }
    },
    "deploy:apply": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "cd ../../terraform",
          "terraform apply -target=aws_lambda_function.stats -target=aws_lambda_event_source_mapping.stats_sqs -target=aws_api_gateway_resource.stats -target=aws_api_gateway_resource.stats_paths -target=aws_api_gateway_method.stats_options -target=aws_api_gateway_method.stats_post -target=aws_api_gateway_integration.stats_options -target=aws_api_gateway_integration.stats_post -target=aws_lambda_permission.stats_api_gateway -auto-approve",
          "terraform apply -target=aws_api_gateway_deployment.main -auto-approve"
        ],
        "parallel": false,
        "cwd": "lambdas/stats-lambda"
      }
    },
    "test-endpoint": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "curl -X POST \"https://$(cd terraform && terraform output -raw api_gateway_url)/stats/load-career\" -H \"Content-Type: application/json\" -d '{\"test\": true}'"
        ],
        "parallel": false,
        "cwd": "."
      }
    },
    "logs": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "aws logs tail /aws/lambda/legacy-sports-dev-stats --follow --region us-east-1"
        ],
        "parallel": false,
        "cwd": "."
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx src/dev.ts",
        "cwd": "lambdas/stats-lambda"
      }
    }
  }
}
