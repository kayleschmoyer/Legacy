{
  "name": "stats-lambda",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "lambdas/stats-lambda",
  "projectType": "application",
  "tags": [],
  "// targets": "to see all targets run: nx show project stats-lambda --web",
  "targets": {
    "build": {
      "executor": "@nx/vite:build",
      "outputs": [
        "{options.outputPath}"
      ],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "lambdas/stats-lambda/dist"
      },
      "configurations": {
        "development": {
          "mode": "development"
        },
        "production": {
          "mode": "production"
        }
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "jestConfig": "lambdas/stats-lambda/jest.config.ts",
        "passWithNoTests": true
      }
    },
    "package": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build"
      ],
      "options": {
        "commands": [
          "powershell -Command \"Compress-Archive -Path 'lambdas/stats-lambda/dist/index.js' -DestinationPath 'lambdas/stats-lambda/dist/index.js.zip' -Force\""
        ],
        "parallel": false
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build"
      ],
      "options": {
        "command": "../../scripts/deploy-lambda.sh stats",
        "cwd": "lambdas/stats-lambda"
      }
    },
    "deploy:plan": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build"
      ],
      "options": {
        "command": "cd ../../terraform && terraform plan -target=aws_lambda_function.stats",
        "cwd": "lambdas/stats-lambda"
      }
    },
    "deploy:apply": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "cd ../../terraform",
          "terraform apply -target=aws_lambda_function.stats -target=aws_lambda_event_source_mapping.stats_sqs -target=aws_api_gateway_resource.stats -target=aws_api_gateway_resource.stats_paths -target=aws_api_gateway_method.stats_options -target=aws_api_gateway_method.stats_post -target=aws_api_gateway_integration.stats_options -target=aws_api_gateway_integration.stats_post -target=aws_lambda_permission.stats_api_gateway -auto-approve",
          "terraform apply -target=aws_api_gateway_deployment.main -auto-approve"
        ],
        "parallel": false,
        "cwd": "lambdas/stats-lambda"
      }
    },
    "test-endpoint": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "curl -X POST \"https://$(cd terraform && terraform output -raw api_gateway_url)/stats/load-career\" -H \"Content-Type: application/json\" -d '{\"test\": true}'"
        ],
        "parallel": false,
        "cwd": "."
      }
    },
    "logs": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "aws logs tail /aws/lambda/legacy-sports-dev-stats --follow --region us-east-1"
        ],
        "parallel": false,
        "cwd": "."
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx src/dev.ts",
        "cwd": "lambdas/stats-lambda"
      }
    }
  }
}