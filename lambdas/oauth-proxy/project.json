{
  "name": "oauth-proxy",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "lambdas/oauth-proxy",
  "projectType": "application",
  "tags": ["lambda", "platform:node", "scope:lambda", "type:auth"],
  "targets": {
    "typecheck": {
      "options": {
        "command": "tsc --noEmit -p tsconfig.app.json"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/dist"],
      "dependsOn": ["^build"],
      "options": {
        "command": "vite build",
        "cwd": "lambdas/oauth-proxy"
      },
      "configurations": {
        "development": {
          "command": "vite build --mode development"
        },
        "production": {
          "command": "vite build --mode production"
        }
      }
    },
    "package": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "echo 'Legacy serverless package command. Use nx deploy oauth-proxy instead.'",
        "cwd": "lambdas/oauth-proxy"
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "../../scripts/deploy-lambda.ps1 -FunctionName oauth-proxy",
        "cwd": "lambdas/oauth-proxy"
      }
    },
    "deploy:plan": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "commands": [
          "echo '🔍 Validating Terraform configuration for OAuth proxy lambda...'",
          "terraform -chdir=terraform/main fmt -check || (echo '⚠️  Terraform formatting issues found' && terraform -chdir=terraform/main fmt)",
          "terraform -chdir=terraform/main validate || echo '⚠️  Terraform validation failed - this may be expected in CI without full AWS context'",
          "terraform -chdir=terraform/main plan -target=aws_lambda_function.oauth_proxy 2>&1 || echo '⚠️  Terraform plan failed - this is expected in CI without terraform state and AWS credentials'"
        ],
        "parallel": false,
        "cwd": "."
      }
    },
    "deploy:apply": {
      "executor": "nx:run-commands",
      "options": {
        "command": "terraform -chdir=terraform/main apply -target=aws_lambda_function.oauth_proxy -auto-approve",
        "cwd": "."
      }
    },
    "test-endpoint": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "curl -X GET \"https://$(terraform -chdir=terraform/main output -raw api_gateway_url)/oauth/health\" -H \"Content-Type: application/json\""
        ],
        "parallel": false,
        "cwd": "."
      }
    },
    "logs": {
      "executor": "nx:run-commands",
      "options": {
        "command": "aws logs tail \"/aws/lambda/legacy-sports-dev-oauth-proxy\" --follow",
        "cwd": "."
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx watch --tsconfig ../../tsconfig.base.json src/dev.ts",
        "cwd": "lambdas/oauth-proxy"
      }
    }
  }
}
