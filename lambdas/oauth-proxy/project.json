{
  "name": "oauth-proxy",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "lambdas/oauth-proxy",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "vite build",
        "cwd": "lambdas/oauth-proxy"
      },
      "configurations": {
        "development": {
          "command": "vite build --mode development"
        },
        "production": {
          "command": "vite build --mode production"
        }
      }
    },
    "package": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "echo 'Legacy serverless package command. Use nx deploy oauth-proxy instead.'",
        "cwd": "lambdas/oauth-proxy"
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "../../scripts/deploy-lambda.ps1 -FunctionName oauth-proxy",
        "cwd": "lambdas/oauth-proxy"
      }
    },
    "deploy:plan": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "commands": [
          "echo '🔍 Validating Terraform configuration for OAuth proxy lambda...'",
          "cd ../../terraform && terraform fmt -check || (echo '⚠️  Terraform formatting issues found' && terraform fmt)",
          "cd ../../terraform && terraform validate || echo '⚠️  Terraform validation failed - this may be expected in CI without full AWS context'",
          "cd ../../terraform && (terraform plan -target=aws_lambda_function.oauth_proxy 2>&1 || echo '⚠️  Terraform plan failed - this is expected in CI without terraform state and AWS credentials')"
        ],
        "parallel": false,
        "cwd": "lambdas/oauth-proxy"
      }
    },
    "deploy:apply": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cd ../../terraform && terraform apply -target=aws_lambda_function.oauth_proxy -auto-approve",
        "cwd": "lambdas/oauth-proxy"
      }
    },
    "test-endpoint": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "curl -X GET \"https://$(cd terraform && terraform output -raw api_gateway_url)/oauth/health\" -H \"Content-Type: application/json\""
        ],
        "parallel": false,
        "cwd": "."
      }
    },
    "logs": {
      "executor": "nx:run-commands",
      "options": {
        "command": "aws logs tail \"/aws/lambda/legacy-sports-dev-oauth-proxy\" --follow",
        "cwd": "terraform"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx watch --tsconfig ../../tsconfig.base.json src/dev.ts",
        "cwd": "lambdas/oauth-proxy"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "lambdas/oauth-proxy/jest.config.ts"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  },
  "tags": []
}
