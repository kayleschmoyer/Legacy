{
  "name": "career_stats_lambda",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "lambdas/career_stats_lambda/career_stats_lambda",
  "targets": {
    "lock": {
      "executor": "@nxlv/python:run-commands",
      "options": {
        "command": "poetry lock --no-update",
        "cwd": "lambdas/career_stats_lambda"
      }
    },
    "add": {
      "executor": "@nxlv/python:add",
      "options": {}
    },
    "update": {
      "executor": "@nxlv/python:update",
      "options": {}
    },
    "remove": {
      "executor": "@nxlv/python:remove",
      "options": {}
    },
    "build": {
      "executor": "@nxlv/python:build",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "outputPath": "lambdas/career_stats_lambda/dist",
        "publish": false,
        "lockedVersions": true,
        "bundleLocalDependencies": true
      }
    },
    "install": {
      "executor": "@nxlv/python:install",
      "options": {
        "silent": false,
        "args": "",
        "cacheDir": ".cache/pypoetry",
        "verbose": false,
        "debug": false
      }
    },
    "lint": {
      "executor": "@nxlv/python:flake8",
      "outputs": [
        "{workspaceRoot}/reports/lambdas/career_stats_lambda/pylint.txt"
      ],
      "options": {
        "outputFile": "reports/lambdas/career_stats_lambda/pylint.txt"
      }
    },
    "test": {
      "executor": "@nxlv/python:run-commands",
      "outputs": [
        "{workspaceRoot}/reports/lambdas/career_stats_lambda/unittests",
        "{workspaceRoot}/coverage/lambdas/career_stats_lambda"
      ],
      "options": {
        "command": "poetry run pytest tests/",
        "cwd": "lambdas/career_stats_lambda"
      }
    },
    "lint:fix:black": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "lambdas/career_stats_lambda",
        "command": "poetry run black career_stats_lambda tests"
      }
    },
    "lint:fix:autopep8": {
      "executor": "nx:run-commands",
      "dependsOn": ["lint:fix:black"],
      "options": {
        "cwd": "lambdas/career_stats_lambda",
        "command": "poetry run autopep8 --in-place --recursive career_stats_lambda tests"
      }
    },
    "lint:fix": {
      "executor": "",
      "dependsOn": ["lint:fix:autopep8", "lint:fix:black"]
    }
  },
  "tags": []
}
