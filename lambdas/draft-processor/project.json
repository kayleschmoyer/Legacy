{
  "name": "draft-processor",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "lambdas/draft-processor",
  "projectType": "application",
  "tags": ["draft", "lambda", "platform:node", "scope:lambda", "type:worker"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/dist"],
      "dependsOn": ["^build"],
      "options": {
        "commands": [
          "vite build",
          "node -e \"require('fs').copyFileSync('lambda-package.json', 'dist/package.json')\""
        ],
        "cwd": "lambdas/draft-processor",
        "parallel": false
      },
      "configurations": {
        "development": {
          "command": "vite build --mode development"
        },
        "production": {
          "command": "vite build --mode production"
        }
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite",
        "cwd": "lambdas/draft-processor"
      }
    },
    "typecheck": {
      "options": {
        "command": "tsc --noEmit"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node dist/index.js",
        "cwd": "lambdas/draft-processor"
      },
      "dependsOn": ["build"]
    },
    "zip": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cd dist && (command -v zip > /dev/null 2>&1 && zip -r ../draft-processor-{args.version}.zip . || echo 'Warning: zip utility not found - skipping packaging.') && cd ..",
        "cwd": "lambdas/draft-processor"
      },
      "dependsOn": ["build"],
      "configurations": {
        "production": {
          "command": "cd dist && zip -r ../draft-processor-{args.version}.zip . && cd ..",
          "cwd": "lambdas/draft-processor"
        }
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "powershell -ExecutionPolicy Bypass -File scripts/deploy-lambda.ps1 -FunctionName draft-processor"
      }
    },
    "deploy:plan": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "commands": [
          "echo '🔍 Validating Terraform configuration for Draft Processor lambda...'",
          "terraform -chdir=terraform/main fmt -check || (echo '⚠️  Terraform formatting issues found' && terraform -chdir=terraform/main fmt)",
          "terraform -chdir=terraform/main validate || echo '⚠️  Terraform validation failed - this may be expected in CI without full AWS context'",
          "terraform -chdir=terraform/main plan -target=aws_lambda_function.draft_processor 2>&1 || echo '⚠️  Terraform plan failed - this is expected in CI without terraform state and AWS credentials'"
        ],
        "parallel": false,
        "cwd": "."
      }
    },
    "deploy:apply": {
      "executor": "nx:run-commands",
      "options": {
        "command": "terraform -chdir=terraform/main apply -target=aws_lambda_function.draft_processor -auto-approve",
        "cwd": "."
      }
    },
    "logs": {
      "executor": "nx:run-commands",
      "options": {
        "command": "aws logs tail \"/aws/lambda/legacy-sports-dev-draft-processor\" --follow",
        "cwd": "."
      }
    }
  }
}
