# =============================================================================
# secrets.auto.tfvars — LOCAL DEV SECRETS
# =============================================================================
# Copy this file to secrets.auto.tfvars and fill in real values.
# secrets.auto.tfvars is gitignored and MUST NEVER be committed.
#
# In CI these variables are supplied as TF_VAR_* environment variables
# from GitHub Actions secrets (see .github/workflows/lambda-terraform-apply.yml).
# =============================================================================

# Google OAuth client secret (from Google Cloud Console → Credentials)
google_oauth_client_secret = "GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# JWT signing secret — generate with: openssl rand -hex 32
jwt_secret_key = "your-32-byte-hex-jwt-secret-here"

# OAuth proxy cookie signing secret — generate with: openssl rand -hex 16
oauth_proxy_cookie_secret = "your-16-byte-hex-cookie-secret-here"

# Jira OAuth 2.0 credentials for the Jira Proxy Lambda (stored in Secrets Manager at runtime)
# Uses service account client credentials flow (2LO) — no refresh token needed.
# Format: JSON object with four fields:
#   client_id      — OAuth 2.0 client ID (from Atlassian Admin > Service Accounts > OAuth 2.0 credentials)
#   client_secret  — OAuth 2.0 client secret
#   cloud_id       — Atlassian Cloud site ID (from https://your-org.atlassian.net/_edge/tenant_info)
#   site_url       — your org's Jira base URL, no trailing slash (used for browse links)
jira_credentials = "{\"client_id\":\"your-oauth-client-id\",\"client_secret\":\"your-oauth-client-secret\",\"cloud_id\":\"your-cloud-id\",\"site_url\":\"https://your-org.atlassian.net\"}"

# Rollbar server-side write token for Lambda error tracking
# From Rollbar → Project Settings → Access Tokens → post_server_item
rollbar_access_token = "your-rollbar-post-server-item-token"

# Rollbar read access token for local API queries (scripts, CLI)
# From Rollbar → Project Settings → Access Tokens → read
# NOTE: Store the real value in .env.local (ROLLBAR_READ_ACCESS_TOKEN), not here.
# This is a local-dev-only token and does not flow through Terraform or Lambdas.

# Stripe API secret key (from Stripe Dashboard → Developers → API keys)
stripe_secret_key = "sk_test_xxxxxxxxxxxxxxxxxxxxxxxx"

# Stripe webhook signing secret (from Stripe Dashboard → Developers → Webhooks → Signing secret)
stripe_webhook_secret = "whsec_xxxxxxxxxxxxxxxxxxxxxxxx"

# Rollbar webhook signing secret for HMAC-SHA256 verification of Rollbar → Discord notifications
# From Rollbar → Project Settings → Notifications → Webhook → Signing Secret
rollbar_webhook_secret = "your-rollbar-webhook-signing-secret"

# Discord webhook URL for Rollbar/CloudWatch alarm notifications
# From Discord → Server Settings → Integrations → Webhooks → Copy Webhook URL
discord_webhook_url = "https://discord.com/api/webhooks/your-webhook-id/your-webhook-token"

# Discord webhook URL for new-user signup notifications (oauth-proxy Lambda)
# From Discord → Server Settings → Integrations → Webhooks → Copy Webhook URL
# Leave empty to disable new-user signup notifications
discord_user_signup_webhook_url = ""

# Discord webhook URL for Stripe event notifications (stripe-webhook Lambda)
# From Discord → Server Settings → Integrations → Webhooks → Copy Webhook URL
# Leave empty to disable Stripe event notifications
discord_stripe_webhook_url = ""

# MLB data provider API key (leave empty for dev — mlb-statsapi requires no key)
# Required for licensed providers in production (balldontlie, rolling-insights)
# See internal documentation for provider selection guidance
mlb_data_api_key = ""

# Cloudflare Workers AI credentials for team logo NSFW classification
# Account ID: From Cloudflare Dashboard → top-right account selector → Account ID
cloudflare_account_id = "your-cloudflare-account-id"
# API Token: From Cloudflare Dashboard → My Profile → API Tokens → Create Token
# Required permissions: "Workers AI — Read"
cloudflare_ai_api_token = "your-cloudflare-ai-api-token"
