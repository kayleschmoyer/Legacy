+// LS-9836: a single scale-down invocation walks every runner in the fleet
+// sequentially, each iteration doing several awaited GitHub API round-trips
+// (see removeRunner/evaluateAndRemoveRunners in scale-runners/scale-down.ts).
+// The `ghr:job_heartbeat` value on a RunnerInfo/RunnerList object comes from
+// the ONE DescribeInstances snapshot taken at the very top of scaleDown(), so
+// for a runner processed late in a slow invocation (large fleet, GitHub API
+// latency/pagination) that snapshot can be stale well past
+// SCALE_DOWN_HEARTBEAT_TTL_SECONDS even though the runner has kept
+// heartbeating in real time — the job-heartbeat override in removeRunner was
+// silently defeated by its own snapshot, not by the runner going idle. Fetch
+// the tag live, immediately before the termination decision, so a
+// still-fresh heartbeat is never missed due to invocation-latency staleness.
+export async function getJobHeartbeatTag(instanceId: string): Promise<string | undefined> {
+  const ec2 = getTracedAWSV3Client(new EC2Client({ region: process.env.AWS_REGION }));
+  const result: DescribeInstancesResult = await ec2.send(
+    new DescribeInstancesCommand({ InstanceIds: [instanceId] }),
+  );
+  const instance = result.Reservations?.[0]?.Instances?.[0];
+  return instance?.Tags?.find((t) => t.Key === 'ghr:job_heartbeat')?.Value;
+}
