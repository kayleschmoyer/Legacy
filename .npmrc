# pnpm configuration for the Legacy Sports monorepo
node-linker=hoisted
public-hoist-pattern[]=*
strict-peer-dependencies=false
auto-install-peers=true
prefer-frozen-lockfile=true

# Use hardlinks from the pnpm store instead of copying files into node_modules.
# This dramatically reduces disk usage when multiple worktrees each need their own
# node_modules (lockfile differs from main). pnpm's content-addressable store at
# D:\.pnpm-store\v3 is shared across all installs on this drive.
package-import-method=hardlink

# Disable side-effects-cache to prevent corrupted postinstall outputs when
# multiple worktrees share the same pnpm content-addressable store on Windows.
side-effects-cache=false
