# .claudeignore — files Claude should not read
# Same syntax as .gitignore

# Secrets & environment variables
.env
.env.*
*.env

# Database dumps (large, may contain PII)
resources/
**/*.dump
**/*.dump.bak
**/*.sql

# Certificates & keys
certs/
**/*.pem
**/*.key
**/*.p12
**/*.p8
**/*.jks
**/*.mobileprovision
**/*.keystore

# Terraform state (contains secrets)
*.tfstate
*.tfstate.*
*.tfstate.backup
.terraform/
terraform.tfvars
*.tfvars
terraform/build/

# Dependencies & generated output (large, low signal)
node_modules/
dist/
build/
.next/
.expo/
.tamagui/
__pycache__/
**/*.tsbuildinfo
**/*.zip

# Logs & scratch output
logs/
scratch/
test-results/
playwright-report/
coverage/

# Lock files (large, rarely useful for context)
pnpm-lock.yaml

# Internal tool state
.twig/
.nx/cache
.nx/workspace-data

# Additional build/cache artifacts
**/.turbo/
**/.vite/
**/storybook-static/
**/*.spec.ts-snapshots/
.screenshots/

# Logs & OS junk
**/*.log
.DS_Store
Thumbs.db

# Terraform plan files (contain credentials)
tfplan
*.tfplan

# Large local caches / ephemeral worktrees
.modules-pool/
.claude/worktrees/

# Native dependency caches
**/Pods/
**/vendor/bundle/

# Mobile binary artifacts
**/*.apk
**/*.aab
**/*.ipa
**/*.dSYM
**/*.dSYM.zip

# RN/Hermes bundles
**/*.jsbundle
**/*.hbc
**/*.bundle

# iOS/Android IDE state
DerivedData/
xcuserdata/
*.iml
.gradle/
.cxx/
.idea/
.vscode/

# Python venv & generic cache
.venv/
.cache/

# Remotion render output
apps/video/out/

# Per-shard Playwright coverage fragments
coverage-fragments/

# Vite/Vitest temp files
vite.config.*.timestamp*
vitest.config.*.timestamp*

# Metro watcher pings
.metro-health-check*
