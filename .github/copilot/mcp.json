{
  "servers": {
    "legacy-sports-ci": {
      "type": "http",
      "url": "$MCP_CI_URL",
      "headers": { "Authorization": "Bearer $MCP_CI_BEARER" }
    },
    "legacy-sports-db": {
      "type": "stdio",
      "command": "node",
      "args": [
        ".github/copilot/hooks/mcp-bootstrap.mjs",
        "node",
        "--import",
        "tsx",
        "tools/mcp/db-server/src/index.ts"
      ]
    },
    "legacy-sports-jira": {
      "type": "http",
      "url": "$MCP_JIRA_URL",
      "headers": { "Authorization": "Bearer $MCP_JIRA_BEARER" }
    },
    "worktree": {
      "type": "stdio",
      "command": "node",
      "args": [
        ".github/copilot/hooks/mcp-bootstrap.mjs",
        "node",
        "--import",
        "tsx",
        "tools/mcp/worktree-server/src/index.ts"
      ]
    },
    "legacy-sports-aws": {
      "type": "stdio",
      "command": "node",
      "args": [
        ".github/copilot/hooks/mcp-bootstrap.mjs",
        "node",
        "--import",
        "tsx",
        "tools/mcp/aws-server/src/index.ts"
      ]
    },
    "legacy-sports-github": {
      "type": "http",
      "url": "$MCP_GITHUB_URL",
      "headers": { "Authorization": "Bearer $MCP_GITHUB_BEARER" }
    },
    "legacy-sports-nx": {
      "type": "stdio",
      "command": "node",
      "args": [
        ".github/copilot/hooks/mcp-bootstrap.mjs",
        "node",
        "--import",
        "tsx",
        "tools/mcp/nx-server/src/index.ts"
      ]
    },
    "legacy-sports-make": {
      "type": "stdio",
      "command": "node",
      "args": [
        ".github/copilot/hooks/mcp-bootstrap.mjs",
        "node",
        "--import",
        "tsx",
        "tools/mcp/make-server/src/index.ts"
      ]
    },
    "legacy-sports-browser": {
      "type": "stdio",
      "command": "node",
      "args": [
        ".github/copilot/hooks/mcp-bootstrap.mjs",
        "node",
        "--import",
        "tsx",
        "tools/mcp/browser-server/src/index.ts"
      ]
    }
  }
}
