{
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "command": ".github/copilot/hooks/setup-worktree-symlink.sh",
        "windows": ".github/copilot/hooks/setup-worktree-symlink.ps1",
        "cwd": ".",
        "timeout": 15
      },
      {
        "type": "command",
        "command": ".github/copilot/hooks/cleanup-orphaned-symlinks.sh",
        "windows": ".github/copilot/hooks/cleanup-orphaned-symlinks.ps1",
        "cwd": ".",
        "timeout": 15
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": ".github/copilot/hooks/cleanup-worktree-symlink.sh",
        "windows": ".github/copilot/hooks/cleanup-worktree-symlink.ps1",
        "cwd": ".",
        "timeout": 15
      }
    ],
    "PreToolUse": [
      {
        "type": "command",
        "command": ".github/copilot/hooks/guard-main-repo.sh",
        "windows": ".github/copilot/hooks/guard-main-repo.ps1",
        "cwd": ".",
        "timeout": 10
      }
    ]
  }
}
