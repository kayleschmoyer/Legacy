#!/bin/sh
#
# pre-push hook — auto-formats code and amends the commit before pushing.
# Installed automatically by `make setup-hooks` (called from `make install`).
#
# Behaviour:
#   1. Runs `nx format:write` to auto-fix any formatting drift.
#   2. If no files changed → push proceeds normally.
#   3. If files changed AND working tree was clean → auto-amends the last
#      commit with the formatting fixes, then ABORTS the push. The developer
#      must re-run `git push` to push the amended commit.
#   4. If files changed AND working tree had other uncommitted changes →
#      blocks the push so the developer can commit/stash first.
#
# To skip formatting only:    SKIP_PREPUSH_LINT=1 git push
# To bypass all hooks:        git push --no-verify

# Git LFS — always runs, even in docs-only worktrees without node_modules
command -v git-lfs >/dev/null 2>&1 || { printf >&2 "\nThis repository is configured for Git LFS but 'git-lfs' was not found on your path. If you no longer wish to use Git LFS, remove this hook by deleting the 'pre-push' file in the hooks directory (set by 'core.hookspath'; usually '.git/hooks').\n\n"; exit 2; }
git lfs pre-push "$@"

# ---------------------------------------------------------------------------
# Check 1: Stray lockfiles — reject if package-lock.json or yarn.lock is tracked
# anywhere in the repo (including subdirectories).
# This project uses pnpm exclusively; other lockfiles indicate an accidental
# `npm install` or `yarn install` run.
# Runs unconditionally — before node_modules / SKIP_PREPUSH_LINT early exits —
# so it cannot be accidentally bypassed by a docs-only worktree setup.
# ---------------------------------------------------------------------------
printf "pre-push: checking for stray lockfiles...\n"
pkg_lock_files=$(git ls-files | grep -E '(^|/)package-lock\.json$' 2>/dev/null || true)
if [ -n "$pkg_lock_files" ]; then
  printf "\nERROR: package-lock.json files are tracked. This project uses pnpm.\n"
  printf "Offending files:\n"
  printf "%s\n" "$pkg_lock_files" | sed 's/^/  /'
  printf "\nFix:\n"
  printf "%s\n" "$pkg_lock_files" | sed 's/^/  git rm -- "/' | sed 's/$/"/'
  printf "  corepack enable && make install\n"
  printf "Then commit the removal and push again.\n"
  printf "To bypass: git push --no-verify\n"
  exit 1
fi
yarn_lock_files=$(git ls-files | grep -E '(^|/)yarn\.lock$' 2>/dev/null || true)
if [ -n "$yarn_lock_files" ]; then
  printf "\nERROR: yarn.lock files are tracked. This project uses pnpm.\n"
  printf "Offending files:\n"
  printf "%s\n" "$yarn_lock_files" | sed 's/^/  /'
  printf "\nFix:\n"
  printf "%s\n" "$yarn_lock_files" | sed 's/^/  git rm -- "/' | sed 's/$/"/'
  printf "  make install\n"
  printf "Then commit the removal and push again.\n"
  printf "To bypass: git push --no-verify\n"
  exit 1
fi

# Skip formatting if node_modules is missing (docs-only worktree without dependencies)
if [ ! -d "node_modules" ] && [ ! -L "node_modules" ]; then
  exit 0
fi

# Allow bypassing the formatting check via environment variable
if [ "${SKIP_PREPUSH_LINT:-0}" = "1" ]; then
  printf "pre-push: SKIP_PREPUSH_LINT=1 — skipping format check\n"
  exit 0
fi

# ---------------------------------------------------------------------------
# Check 2: Conflict markers — reject if any tracked file contains <<<<<<<,
# =======, or >>>>>>> (7-char markers). Fast (<1s) and catches unresolved
# conflicts from silent rerere failures that other tools might miss.
# ---------------------------------------------------------------------------
printf "pre-push: checking for conflict markers...\n"
conflict_files=$(git grep -l -E '^(<{7}|={7}|>{7})' -- ':(exclude)**/*.md' ':(exclude).github/hooks/*' 2>/dev/null || true)
if [ -n "$conflict_files" ]; then
  printf "\nERROR: Unresolved conflict markers found in:\n"
  printf "%s\n" "$conflict_files" | sed 's/^/  /'
  printf "\nResolve these conflicts before pushing.\n"
  printf "To bypass: git push --no-verify\n"
  exit 1
fi

# ---------------------------------------------------------------------------
# Check 3: Terraform validate — when terraform files changed, run
# terraform init -backend=false && terraform validate to catch undeclared
# variables and syntax errors before CI (~5s).
# ---------------------------------------------------------------------------
# Prefer diffing against the upstream tracking branch to catch all unpushed
# Terraform changes, falling back to HEAD~1 if no upstream is configured.
tf_base_ref='HEAD~1'
if git rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' >/dev/null 2>&1; then
  tf_base_ref='@{upstream}'
fi
tf_changed=$(git diff --name-only "$tf_base_ref"...HEAD -- 'terraform/' 2>/dev/null || true)
if [ -n "$tf_changed" ] && command -v terraform >/dev/null 2>&1; then
  printf "pre-push: validating terraform...\n"
  # As of LS-2425, terraform configuration is split into terraform/main/ and
  # terraform/runners/. Validate both — either may have changed.
  for tf_dir in terraform/main terraform/runners; do
    if [ ! -d "$tf_dir" ]; then
      continue
    fi
    tf_init_out=$(terraform -chdir="$tf_dir" init -backend=false -input=false 2>&1)
    tf_init_status=$?
    if [ $tf_init_status -ne 0 ]; then
      printf >&2 "\nWARNING: terraform init failed in %s (exit %d) — skipping validate. Output:\n%s\n" "$tf_dir" "$tf_init_status" "$tf_init_out"
      continue
    fi
    tf_validate_out=$(terraform -chdir="$tf_dir" validate 2>&1)
    tf_validate_status=$?
    if [ $tf_validate_status -ne 0 ]; then
      printf "\nERROR: terraform validate failed in %s:\n%s\n" "$tf_dir" "$tf_validate_out"
      printf "\nFix the terraform errors before pushing.\n"
      printf "To bypass: git push --no-verify\n"
      exit 1
    fi
  done
fi

printf "pre-push: running code formatter...\n"

# Snapshot working-tree state BEFORE formatting
pre_state=$(git status --porcelain)

pnpm exec nx format:write 2>&1
status=$?
if [ $status -ne 0 ]; then
  printf "\nERROR: nx format:write failed (exit %d). Fix the error and try again.\n" "$status"
  printf "To bypass: git push --no-verify\n"
  exit 1
fi

# Check if format:write changed any files
changed=$(git diff --name-only)
if [ -z "$changed" ]; then
  # Nothing changed — formatting was already clean
  exit 0
fi

# Files were reformatted
if [ -z "$pre_state" ]; then
  # Working tree was clean before format:write → auto-amend is safe
  printf "  Formatting fixed files; auto-amending last commit...\n"
  git add -A
  if ! git commit --amend --no-edit --no-verify; then
    printf "\nERROR: git commit --amend failed. Please amend manually and push again.\n"
    exit 1
  fi
  printf "  ✓ Format fixes folded into previous commit.\n"
  printf "  Push aborted — run 'git push' again to push the amended commit.\n"
  exit 1
else
  # Working tree had other uncommitted changes — can't safely amend
  printf "\n"
  printf "ERROR: Formatting fixed the following files:\n"
  printf "%s\n" "$changed" | sed 's/^/  /'
  printf "\n"
  printf "You have other uncommitted changes, so the hook cannot auto-amend.\n"
  printf "Options:\n"
  printf "  1. git stash -u && git add -A && git commit --amend --no-edit && git stash pop\n"
  printf "  2. git add -A && git commit -m 'style: apply formatting'\n"
  printf "To bypass: git push --no-verify\n"
  exit 1
fi
