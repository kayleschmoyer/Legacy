{
  "name": "@legacy-sports/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "all": "nx affected -t build lint:fix lint format test make-cache bundle prebuild",
    "clean:node": "npkill -d",
    "clean:python": "rimraf --glob **/.venv",
    "clean": "npm run clean:python && npm run clean:node",
    "cli": "nx start cli",
    "codegen": "nx run-many -t codegen",
    "create-python-project": "nx generate @nxlv/python:poetry-project",
    "graphiql": "nx serve graphql-explorer",
    "install-all": "npm run install:node && npm run install:poetry",
    "install:node": "npm ci",
    "install:poetry": "poetry install",
    "setup:node": "npm ci",
    "setup:python": "poetry install --sync",
    "setup": "npm run setup:node && npm run setup:python",
    "start": "nx start app",
    "dev:lambdas": "node scripts/start-dev-services.js",
    "dev:db": "nx run db:serve",
    "dev:oauth": "nx run oauth-proxy:serve",
    "dev:stats": "nx run stats-lambda:serve",
    "dev:game-selection": "nx run game-selection:serve",
    "check:services": "node scripts/check-services.js",
    "android": "nx run-android app",
    "ios": "nx run-ios app",
    "build-android": "nx build-android app",
    "build-ios": "nx build-ios app",
    "storybook": "cd lib/shared-components && npm run storybook",
    "storybook:build": "cd lib/shared-components && npm run build-storybook"
  },
  "nx": {
    "targets": {
      "all": {
        "inputs": [
          "^build",
          "^lint",
          "^format",
          "^test",
          "^bundle",
          "^prebuild"
        ]
      },
      "dev": {
        "dependsOn": [
          {
            "projects": [
              "app"
            ],
            "target": "start"
          },
          {
            "projects": [
              "graphql-explorer"
            ],
            "target": "serve"
          },
          {
            "projects": [
              "oauth-proxy"
            ],
            "target": "dev"
          },
          {
            "projects": [
              "db"
            ],
            "target": "dev"
          }
        ]
      }
    }
  },
  "private": true,
