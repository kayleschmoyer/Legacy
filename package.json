    "lint:libs": "nx run-many --target=lint --projects=tag:scope:lib",
    "lint:apps": "nx run-many --target=lint --projects=tag:scope:app",
    "lint:lambdas": "nx run-many --target=lint --projects=tag:scope:lambda",
    "clean:nx": "nx reset",
    "clean:deps": "rimraf node_modules package-lock.json && pnpm install",
    "dev": "concurrently \"pnpm run dev:web\" \"pnpm run dev:lambdas\"",
    "dev:web": "nx serve web",
    "affected:build": "nx affected --target=build",
    "affected:test": "nx affected --target=test",
    "affected:lint": "nx affected --target=lint"
