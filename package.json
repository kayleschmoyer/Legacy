    "sync-env:dry-run": "powershell -ExecutionPolicy Bypass -File scripts/sync-env.ps1 -DryRun",
    "sync-env:backup": "powershell -ExecutionPolicy Bypass -File scripts/sync-env.ps1 -Backup",
