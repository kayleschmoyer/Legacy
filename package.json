  "scripts": {
    "all": "nx affected -t build lint:fix lint format test make-cache bundle typecheck",
    "android": "nx run-android app",
    "build-android": "nx build-android app",
    "build-android-debug": "nx build-android-debug app",
    "build-ios": "nx build-ios app",
    "check:services": "node scripts/check-services.js",
    "clean:node": "npkill -d",
    "clean:python": "rimraf --glob **/.venv",
    "clean": "npm run clean:python && npm run clean:node",
    "cli": "nx start cli",
    "codegen": "nx run-many -t codegen",
    "create-python-project": "nx generate @nxlv/python:poetry-project",
    "db:test": "cd lib/db-client && npm run db:test",
    "db:test:production": "cd lib/db-client && npm run db:test:production",
    "db:url": "cd lib/db-client && npm run db:url",
    "db:url:production": "cd lib/db-client && npm run db:url:production",
    "db:psql": "cd lib/db-client && npm run db:psql",
    "db:psql:production": "cd lib/db-client && npm run db:psql:production",
    "db:credentials": "cd lib/db-client && npm run db:credentials",
    "db:credentials:production": "cd lib/db-client && npm run db:credentials:production",
    "migrate": "tsx --tsconfig tsconfig.base.json apps/cli/src/main.ts run-migrations",
    "migrate:dry-run": "tsx --tsconfig tsconfig.base.json apps/cli/src/main.ts run-migrations --dry-run --verbose",
    "migrate:status": "tsx --tsconfig tsconfig.base.json apps/cli/src/main.ts run-migrations --status --verbose",
    "migrate:validate": "tsx --tsconfig tsconfig.base.json apps/cli/src/main.ts run-migrations --validate --verbose",
    "migrate:production": "tsx --tsconfig tsconfig.base.json apps/cli/src/main.ts run-migrations --production --verbose",
    "migrate:production:dry-run": "tsx --tsconfig tsconfig.base.json apps/cli/src/main.ts run-migrations --production --dry-run --verbose",
    "migrate:public": "tsx --tsconfig tsconfig.base.json apps/cli/src/main.ts run-migrations --schema public --verbose",
    "migrate:internal": "tsx --tsconfig tsconfig.base.json apps/cli/src/main.ts run-migrations --schema internal --verbose",
    "security:validate": "node scripts/validate-secrets.js",
    "security:install-hooks": "node scripts/install-git-hooks.js",
    "dev:db": "nx run db:serve",
    "dev:game-selection": "nx run game-selection:serve",
    "dev:lambdas": "node scripts/start-dev-services.js",
    "dev:oauth": "nx run oauth-proxy:serve",
    "dev:stats": "nx run stats-lambda:serve",
    "graphiql": "nx serve graphql-explorer",
    "install-all": "npm run install:node && npm run install:poetry",
    "install:node": "npm ci",
    "install:poetry": "poetry install",
    "ios": "nx run-ios app",
    "setup:node": "npm ci",
    "setup:python": "poetry install --sync",
    "setup": "npm run setup:node && npm run setup:python",
    "start": "nx dev web",
    "storybook:build": "cd lib/shared-components && npm run build-storybook",
    "storybook": "cd lib/shared-components && npm run storybook",
    "sync-env": "powershell -ExecutionPolicy Bypass -File scripts/sync-env.ps1",
    "sync-env:direct": "powershell -ExecutionPolicy Bypass -File scripts/sync-env.ps1 -DatabaseEndpoint direct",
    "sync-env:dry-run": "powershell -ExecutionPolicy Bypass -File scripts/sync-env.ps1 -DryRun",
    "sync-env:backup": "powershell -ExecutionPolicy Bypass -File scripts/sync-env.ps1 -Backup",
    "test:all": "nx run-many -t test",
    "test:changed": "nx affected -t test",
    "test:watch": "nx run-many -t test --watch",
    "test": "echo 'Use test:changed or test:all for running tests'",
    "typecheck": "nx run-many -t typecheck",
    "validate:auth-security": "node scripts/validate-auth-security.js",
    "validate:package-json": "node scripts/validate-package-json-standards.js",
    "validate:workspace-deps": "node scripts/validate-workspace-deps.js",
    "validate": "npm run validate:package-json && npm run validate:workspace-deps && npm run validate:auth-security"
  },
