{
  "name": "cli",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/cli/src",
  "projectType": "application",
  "tags": [
    "platform:node",
    "scope:app",
    "type:cli"
  ],
  "targets": {
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": [
        "{options.outputPath}"
      ],
      "defaultConfiguration": "production",
      "options": {
        "platform": "node",
        "outputPath": "dist/apps/cli",
        "format": [
          "cjs"
        ],
        "bundle": true,
        "main": "apps/cli/src/main.ts",
        "tsConfig": "apps/cli/tsconfig.app.json",
        "assets": [
          "apps/cli/src/assets"
        ],
        "generatePackageJson": true,
        "esbuildOptions": {
          "sourcemap": true,
          "outExtension": {
            ".js": ".js"
          },
          "external": [
            "pg-native"
          ]
        }
      },
      "configurations": {
        "development": {},
        "production": {
          "esbuildOptions": {
            "sourcemap": false,
            "outExtension": {
              ".js": ".js"
            },
            "external": [
              "pg-native"
            ]
          }
        }
      }
    },
    "serve": {
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": [
        "build"
      ],
      "options": {
        "buildTarget": "cli:build",
        "runBuildTargetDependencies": false
      },
      "configurations": {
        "development": {
          "buildTarget": "cli:build:development"
        },
        "production": {
          "buildTarget": "cli:build:production"
        }
      }
    },
    "codegen": {
      "executor": "nx:run-commands",
      "options": {
        "command": "graphql-codegen --require tsconfig-paths/register --config codegen.ts",
        "cwd": "apps/cli"
      }
    },
    "codegen:db": {
      "executor": "nx:run-commands",
      "options": {
        "command": "graphql-codegen --require tsconfig-paths/register --config codegen.ts",
        "cwd": "apps/cli"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p tsconfig.app.json",
        "cwd": "apps/cli"
      }
    },
    "start": {
      "executor": "nx:run-commands",
      "options": {
        "command": "ts-node -r tsconfig-paths/register src/main.ts",
        "cwd": "apps/cli"
      }
    },
    "run": {
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": [
        "build"
      ],
      "options": {
        "buildTarget": "cli:build",
        "runBuildTargetDependencies": false,
        "watch": false
      },
      "configurations": {
        "development": {
          "buildTarget": "cli:build:development",
          "watch": false
        },
        "production": {
          "buildTarget": "cli:build:production",
          "watch": false
        }
      }
    },
    "compute-scoring": {
      "executor": "nx:run-commands",
      "options": {
        "command": "ts-node -r tsconfig-paths/register src/main.ts compute-scoring",
        "cwd": "apps/cli"
      }
    },
    "run-migrations": {
      "executor": "nx:run-commands",
      "options": {
        "command": "ts-node -r tsconfig-paths/register src/main.ts run-migrations",
        "cwd": "apps/cli"
      }
    },
    "load-players": {
      "executor": "nx:run-commands",
      "options": {
        "command": "ts-node -r tsconfig-paths/register src/main.ts load-players",
        "cwd": "apps/cli"
      }
    },
    "load-career-stats": {
      "executor": "nx:run-commands",
      "options": {
        "command": "ts-node -r tsconfig-paths/register src/main.ts load-career-stats",
        "cwd": "apps/cli"
      }
    },
    "load-single-player-stats": {
      "executor": "nx:run-commands",
      "options": {
        "command": "ts-node -r tsconfig-paths/register src/main.ts load-single-player-stats",
        "cwd": "apps/cli"
      }
    },
    "list-players": {
      "executor": "nx:run-commands",
      "options": {
        "command": "ts-node -r tsconfig-paths/register src/main.ts list-players",
        "cwd": "apps/cli"
      }
    },
    "inspect-database": {
      "executor": "nx:run-commands",
      "options": {
        "command": "ts-node -r tsconfig-paths/register src/main.ts inspect-database",
        "cwd": "apps/cli"
      }
    },
    "test-connection": {
      "executor": "nx:run-commands",
      "options": {
        "command": "ts-node -r tsconfig-paths/register src/main.ts test-connection",
        "cwd": "apps/cli"
      }
    },
    "test-db": {
      "executor": "nx:run-commands",
      "options": {
        "command": "ts-node -r tsconfig-paths/register src/main.ts test-db",
        "cwd": "apps/cli"
      }
    },
    "test-raw-connection": {
      "executor": "nx:run-commands",
      "options": {
        "command": "ts-node -r tsconfig-paths/register src/main.ts test-raw-connection",
        "cwd": "apps/cli"
      }
    },
    "create-matchup": {
      "executor": "nx:run-commands",
      "options": {
        "command": "ts-node -r tsconfig-paths/register src/main.ts create-matchup",
        "cwd": "apps/cli"
      }
    },
    "fix-users-table": {
      "executor": "nx:run-commands",
      "options": {
        "command": "ts-node -r tsconfig-paths/register src/main.ts fix-users-table",
        "cwd": "apps/cli"
      }
    },
    "test-internal": {
      "executor": "nx:run-commands",
      "options": {
        "command": "ts-node -r tsconfig-paths/register src/main.ts test-internal",
        "cwd": "apps/cli"
      }
    },
    "inspect-sqs-queue": {
      "executor": "nx:run-commands",
      "options": {
        "command": "ts-node -r tsconfig-paths/register src/main.ts inspect-sqs-queue",
        "cwd": "apps/cli"
      }
    },
    "inspect-sqs-queue:peek": {
      "executor": "nx:run-commands",
      "options": {
        "command": "ts-node -r tsconfig-paths/register src/main.ts inspect-sqs-queue --action peek",
        "cwd": "apps/cli"
      }
    },
    "decode-jwt": {
      "executor": "nx:run-commands",
      "options": {
        "command": "ts-node -r tsconfig-paths/register src/main.ts decode-jwt",
        "cwd": "apps/cli"
      }
    },
    "migrate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "ts-node -r tsconfig-paths/register src/main.ts run-migrations",
        "cwd": "apps/cli"
      }
    },
    "migrate:dry-run": {
      "executor": "nx:run-commands",
      "options": {
        "command": "ts-node -r tsconfig-paths/register src/main.ts run-migrations --dry-run --verbose",
        "cwd": "apps/cli"
      }
    },
    "migrate:status": {
      "executor": "nx:run-commands",
      "options": {
        "command": "ts-node -r tsconfig-paths/register src/main.ts run-migrations --status --verbose",
        "cwd": "apps/cli"
      }
    },
    "migrate:validate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "ts-node -r tsconfig-paths/register src/main.ts run-migrations --validate --verbose",
        "cwd": "apps/cli"
      }
    },
    "migrate:production": {
      "executor": "nx:run-commands",
      "options": {
        "command": "ts-node -r tsconfig-paths/register src/main.ts run-migrations --production --verbose",
        "cwd": "apps/cli"
      }
    },
    "migrate:production:dry-run": {
      "executor": "nx:run-commands",
      "options": {
        "command": "ts-node -r tsconfig-paths/register src/main.ts run-migrations --production --dry-run --verbose",
        "cwd": "apps/cli"
      }
    },
    "migrate:public": {
      "executor": "nx:run-commands",
      "options": {
        "command": "ts-node -r tsconfig-paths/register src/main.ts run-migrations --schema public --verbose",
        "cwd": "apps/cli"
      }
    },
    "migrate:internal": {
      "executor": "nx:run-commands",
      "options": {
        "command": "ts-node -r tsconfig-paths/register src/main.ts run-migrations --schema internal --verbose",
        "cwd": "apps/cli"
      }
    }
  }
}
