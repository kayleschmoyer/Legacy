{
  "name": "cli",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/cli/src",
  "projectType": "application",
  "tags": ["platform:node", "scope:app", "type:cli"],
  "targets": {
    "codegen": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/src/api/db/**/*.graphql",
        "{projectRoot}/codegen.ts",
        "{projectRoot}/tsconfig*.json",
        "{workspaceRoot}/tsconfig.base.json",
        "{workspaceRoot}/lib/codegen/codegen.base.ts",
        "{workspaceRoot}/lambdas/db/schema.graphql",
        { "externalDependencies": ["@graphql-codegen/cli", "tsconfig-paths"] }
      ],
      "outputs": ["{projectRoot}/src/api/db/graphql.generated.ts"],
      "options": {
        "command": "graphql-codegen --require tsconfig-paths/register --config codegen.ts",
        "cwd": "apps/cli"
      }
    },
    "codegen:db": {
      "dependsOn": ["codegen"]
    },
    "typecheck": {
      "options": {
        "command": "tsc --noEmit -p tsconfig.app.json"
      }
    },
    "start": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx --tsconfig ../../tsconfig.base.json src/main.ts",
        "cwd": "apps/cli"
      }
    },
    "compute-scoring": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx --tsconfig ../../tsconfig.base.json src/main.ts compute-scoring",
        "cwd": "apps/cli"
      }
    },
    "run-migrations": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx --tsconfig ../../tsconfig.base.json src/main.ts run-migrations",
        "cwd": "apps/cli"
      }
    },
    "load-players": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx --tsconfig ../../tsconfig.base.json src/main.ts load-players",
        "cwd": "apps/cli"
      }
    },
    "load-career-stats": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx --tsconfig ../../tsconfig.base.json src/main.ts load-career-stats",
        "cwd": "apps/cli"
      }
    },
    "load-single-player-stats": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx --tsconfig ../../tsconfig.base.json src/main.ts load-single-player-stats",
        "cwd": "apps/cli"
      }
    },
    "list-players": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx --tsconfig ../../tsconfig.base.json src/main.ts list-players",
        "cwd": "apps/cli"
      }
    },
    "inspect-database": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx --tsconfig ../../tsconfig.base.json src/main.ts inspect-database",
        "cwd": "apps/cli"
      }
    },
    "reset-database": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx --tsconfig ../../tsconfig.base.json src/main.ts reset-database",
        "cwd": "apps/cli"
      }
    },
    "test-connection": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx --tsconfig ../../tsconfig.base.json src/main.ts test-connection",
        "cwd": "apps/cli"
      }
    },
    "test-db": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx --tsconfig ../../tsconfig.base.json src/main.ts test-db",
        "cwd": "apps/cli"
      }
    },
    "test-raw-connection": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx --tsconfig ../../tsconfig.base.json src/main.ts test-raw-connection",
        "cwd": "apps/cli"
      }
    },
    "create-matchup": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx --tsconfig ../../tsconfig.base.json src/main.ts create-matchup",
        "cwd": "apps/cli"
      }
    },
    "fix-users-table": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx --tsconfig ../../tsconfig.base.json src/main.ts fix-users-table",
        "cwd": "apps/cli"
      }
    },
    "test-internal": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx --tsconfig ../../tsconfig.base.json src/main.ts test-internal",
        "cwd": "apps/cli"
      }
    },
    "inspect-sqs-queue": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx --tsconfig ../../tsconfig.base.json src/main.ts inspect-sqs-queue",
        "cwd": "apps/cli"
      }
    },
    "inspect-sqs-queue:peek": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx --tsconfig ../../tsconfig.base.json src/main.ts inspect-sqs-queue --action peek",
        "cwd": "apps/cli"
      }
    },
    "decode-jwt": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx --tsconfig ../../tsconfig.base.json src/main.ts decode-jwt",
        "cwd": "apps/cli"
      }
    },
    "migrate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx --tsconfig ../../tsconfig.base.json src/main.ts run-migrations",
        "cwd": "apps/cli"
      }
    },
    "migrate:dry-run": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx --tsconfig ../../tsconfig.base.json src/main.ts run-migrations --dry-run --verbose",
        "cwd": "apps/cli"
      }
    },
    "migrate:status": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx --tsconfig ../../tsconfig.base.json src/main.ts run-migrations --status --verbose",
        "cwd": "apps/cli"
      }
    },
    "migrate:validate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx --tsconfig ../../tsconfig.base.json src/main.ts run-migrations --validate --verbose",
        "cwd": "apps/cli"
      }
    },
    "migrate:production": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx --tsconfig ../../tsconfig.base.json src/main.ts run-migrations --production --verbose",
        "cwd": "apps/cli"
      }
    },
    "migrate:production:dry-run": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx --tsconfig ../../tsconfig.base.json src/main.ts run-migrations --production --dry-run --verbose",
        "cwd": "apps/cli"
      }
    },
    "migrate:public": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx --tsconfig ../../tsconfig.base.json src/main.ts run-migrations --schema public --verbose",
        "cwd": "apps/cli"
      }
    },
    "migrate:internal": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx --tsconfig ../../tsconfig.base.json src/main.ts run-migrations --schema internal --verbose",
        "cwd": "apps/cli"
      }
    },
    "query-db": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx --tsconfig ../../tsconfig.base.json src/main.ts query-db",
        "cwd": "apps/cli"
      }
    }
  }
}
