{
  "preset": "../../jest.preset.js",
  "rootDir": ".",
  "testMatch": [
    "<rootDir>/src/**/*.test.ts?(x)",
    "<rootDir>/src/**/*.spec.ts?(x)"
  ],
  "testTimeout": 120000,
  "maxWorkers": 1,
  "testEnvironment": "node",
  "setupFilesAfterEnv": ["<rootDir>/test-setup.ts"],
  "transform": {
    "^.+\\.(ts|js|html)$": [
      "ts-jest",
      {
        "tsconfig": "<rootDir>/tsconfig.e2e.json"
      }
    ]
  }
}
