{
  "name": "app-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/app-e2e/src",
  "projectType": "application",
  "tags": [],
  "implicitDependencies": [
    "app"
  ],
  "// targets": "to see all targets run: nx show project app-e2e --web",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'Building React Native app for e2e testing...'"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "options": {
        "jestConfig": "apps/app-e2e/jest.config.json",
        "passWithNoTests": true
      },
      "configurations": {
        "ci": {
          "runInBand": true,
          "ci": true,
          "coverage": false
        }
      }
    },
    "e2e-android": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx wdio run ./wdio.conf.js --spec ./src/app.e2e.js",
        "cwd": "apps/app-e2e"
      }
    },
    "e2e-android-debug": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx wdio run ./wdio.conf.js --spec ./src/app.e2e.js --logLevel debug",
        "cwd": "apps/app-e2e"
      }
    },
    "test-build-verification": {
      "executor": "nx:run-commands",
      "options": {
        "command": "jest apps/app-e2e/src/build-verification.spec.ts --config apps/app-e2e/jest.config.json"
      }
    },
    "test-sports-functionality": {
      "executor": "nx:run-commands",
      "options": {
        "command": "jest apps/app-e2e/src/sports.spec.ts --config apps/app-e2e/jest.config.json"
      }
    },
    "test-smoke": {
      "executor": "nx:run-commands",
      "options": {
        "command": "jest apps/app-e2e/src/app.spec.ts --testNamePattern=\"should launch app successfully|should display main navigation\" --config apps/app-e2e/jest.config.json"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": [
        "{options.outputFile}"
      ],
      "options": {
        "lintFilePatterns": [
          "apps/app-e2e/**/*.{ts,tsx,js,jsx}"
        ]
      }
    }
  }
}