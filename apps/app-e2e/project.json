{
  "name": "app-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/app-e2e/src",
  "projectType": "application",
  "tags": ["platform:mobile", "scope:e2e", "type:test"],
  "implicitDependencies": ["app"],
  "// targets": "to see all targets run: nx show project app-e2e --web",
  "targets": {
    "typecheck": {
      "options": {
        "command": "tsc --noEmit -p tsconfig.json"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'Building React Native app for e2e testing...'"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "options": {
        "jestConfig": "apps/app-e2e/jest.config.json",
        "passWithNoTests": true
      },
      "configurations": {
        "ci": {
          "runInBand": true,
          "ci": true,
          "coverage": false
        }
      }
    },
    "e2e-android": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec wdio run ./wdio.conf.js --spec ./src/app.e2e.js",
        "cwd": "apps/app-e2e"
      }
    },
    "e2e-android-debug": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec wdio run ./wdio.conf.js --spec ./src/app.e2e.js --logLevel debug",
        "cwd": "apps/app-e2e"
      }
    },
    "test-build-verification": {
      "executor": "@nx/jest:jest",
      "options": {
        "jestConfig": "apps/app-e2e/jest.config.json",
        "testPathPattern": ["build-verification\\.spec\\.ts"]
      }
    },
    "test-sports-functionality": {
      "executor": "@nx/jest:jest",
      "options": {
        "jestConfig": "apps/app-e2e/jest.config.json",
        "testPathPattern": ["sports\\.spec\\.ts"]
      }
    },
    "test-smoke": {
      "executor": "@nx/jest:jest",
      "options": {
        "jestConfig": "apps/app-e2e/jest.config.json",
        "testPathPattern": ["app\\.spec\\.ts"],
        "testNamePattern": "should have root layout component|should have drawer navigator"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["apps/app-e2e/**/*.{ts,tsx,js,jsx}"],
        "maxWarnings": 0
      }
    }
  }
}
