{
  "name": "web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/web/src",
  "projectType": "application",
  "tags": ["platform:web", "scope:app", "type:frontend"],
  "implicitDependencies": ["db"],
  "// targets": "to see all targets run: nx show project web --web",
  "targets": {
    "typecheck": {
      "dependsOn": ["codegen"],
      "options": {
        "command": "tsc --noEmit -p tsconfig.app.json"
      }
    },
    "dev": {
      "executor": "@nx/vite:dev-server",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "web:build",
        "port": 4200,
        "host": "localhost",
        "strictPort": true
      },
      "configurations": {
        "development": {
          "buildTarget": "web:build:development"
        },
        "production": {
          "buildTarget": "web:build:production"
        }
      }
    },
    "serve": {
      "executor": "@nx/vite:dev-server",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "web:build",
        "port": 4200,
        "host": "localhost",
        "strictPort": true
      },
      "configurations": {
        "development": {
          "buildTarget": "web:build:development"
        },
        "production": {
          "buildTarget": "web:build:production"
        }
      }
    },
    "build": {
      "executor": "@nx/vite:build",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/web"
      },
      "configurations": {
        "development": {
          "mode": "development",
          "sourcemap": true
        },
        "production": {
          "mode": "production",
          "sourcemap": false
        },
        "deploy": {
          "mode": "production",
          "sourcemap": "hidden",
          "minify": true,
          "reportCompressedSize": true
        }
      }
    },
    "codegen": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/src/api/db/**/*.graphql",
        "{projectRoot}/codegen.ts",
        "{projectRoot}/tsconfig*.json",
        "{workspaceRoot}/tsconfig.base.json",
        "{workspaceRoot}/lib/codegen/codegen.base.ts",
        "{workspaceRoot}/lambdas/db/schema.graphql",
        { "externalDependencies": ["@graphql-codegen/cli", "tsconfig-paths"] }
      ],
      "outputs": ["{projectRoot}/src/api/db/graphql.generated.ts"],
      "options": {
        "command": "graphql-codegen --require tsconfig-paths/register --config codegen.ts",
        "cwd": "apps/web"
      }
    },
    "codegen:db": {
      "dependsOn": ["codegen"]
    }
  }
}
