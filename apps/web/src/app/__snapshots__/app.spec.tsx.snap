                cursor="pointer"
                gap="$2"
              >
                <img
                  alt="Legacy Sports"
                  data-testid="header-logo"
                  src="/logo.png"
                  style="height: 38px; width: auto; display: block;"
                />
                <p
                  color="$color12"
                  data-testid="brand-text"
                  font-size="22"
                  font-weight="700"
                  letter-spacing="1"
                  marginbottom="0"
                  style="font-family: 'Big Shoulders Display', sans-serif;"
                  userselect="none"
                >
                  Legacy Sports
                </p>
              </div>
            </a>
          </div>
          <div
            display="none"
          >
            <div>
              Sports Dropdown
            </div>
            <div>
              Players Dropdown
            </div>
            <div>
              My Leagues Dropdown
            </div>
            <a
              aria-label="Games"
              href="/games/season-draft"
              style="text-decoration: none; flex-shrink: 0;"
            >
              <button>
                <div
                  alignitems="center"
                  gap="$2"
                >
                  Gamepad2
                  <p
                    marginbottom="0"
                  >
                    Games
                  </p>
                </div>
              </button>
            </a>
          </div>
          <div
            alignitems="center"
            flex="1"
            gap="$3"
            justifycontent="flex-end"
          >
            <div
              display="none"
            />
            <div>
              Notification Dropdown
            </div>
            <div>
              User Profile Dropdown
            </div>
            <button
              aria-expanded="false"
              aria-label="Open menu"
            >
              Menu
            </button>
          </div>
        </div>
      </div>
    </nav>
  </div>
  <div
    data-testid="main-content"
    flex="1"
    id="main-content"
    padding="$4"
    tabindex="-1"
    tag="main"
  >
