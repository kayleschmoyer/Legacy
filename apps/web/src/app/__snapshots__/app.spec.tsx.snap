          </a>
        </div>
        <div
          alignitems="center"
          flexshrink="0"
          gap="$3"
        >
          <div>
            User Profile Dropdown
          </div>
          <button
            aria-expanded="false"
            aria-label="Open menu"
          >
            <p
              font-size="22"
              lineheight="24"
            >
              ☰
            </p>
