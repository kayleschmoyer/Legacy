exports[`App FootballHubPage should match complete football page layout snapshot 1`] = `
<div>
  <div>
    Global Announcer
  </div>
  <a
    class="skip-link sr-only"
    data-testid="skip-link"
    href="#main-content"
  >
    Skip to main content
  </a>
  <div
    role="banner"
    style="position: sticky; overflow: visible;"
    top="0"
    zindex="200"
  >
    <nav
      aria-label="Primary"
    >
      <div
        style="border-bottom-color: rgb(31, 45, 72);"
      >
        <div
          display="none"
          gap="0"
          padding="0"
        >
          <div
            alignitems="center"
            backgroundcolor="$background075"
            borderbottomwidth="1"
            bordercolor="$glassBorder"
            gap="$4"
            height="56"
            justifycontent="space-between"
            paddinghorizontal="$4"
            position="sticky"
            top="0"
            width="100%"
            zindex="100"
          >
            <div
              alignitems="center"
              gap="$2"
            >
              <a
                aria-label="Legacy Sports home"
                href="/"
                style="text-decoration: none; flex-shrink: 0;"
              >
                <div
                  alignitems="center"
                  cursor="pointer"
                  gap="0"
                >
                  <img
                    alt="Legacy Sports"
                    data-testid="header-logo"
                    src="/logo.png"
                    style="height: 38px; width: auto; display: block; transition: height 200ms ease;"
                  />
                  <div
                    data-testid="brand-text"
                    style="display: flex; flex-direction: column; user-select: none; line-height: 1; overflow: hidden; white-space: nowrap; margin-left: 8px; max-width: 140px; opacity: 1; transition: max-width 200ms ease, margin-left 200ms ease, opacity 150ms ease;"
                  >
                    <span
                      color="$brandGoldLight"
                      style="font-family: "Big Shoulders Display", system-ui, sans-serif; font-weight: 800; font-size: 14px; letter-spacing: 0.04em; line-height: 1;"
                    >
                      LEGACY
                    </span>
                    <span
                      color="$color12"
                      style="font-family: "Big Shoulders Display", system-ui, sans-serif; font-weight: 700; font-size: 11px; letter-spacing: 0.16em; line-height: 1;"
                    >
                      SPORTS
                    </span>
                  </div>
                </div>
              </a>
            </div>
            <div>
              League Switcher
            </div>
            <div
              alignitems="center"
              backgroundcolor="$surfacePanel"
              bordercolor="$outlineSubtle"
              borderradius="9999"
              borderwidth="1"
              flex="1"
              gap="4"
              justifycontent="center"
              paddinghorizontal="6"
              paddingvertical="6"
            >
              <div
                alignitems="center"
                backgroundcolor="transparent"
                borderradius="9999"
                cursor="pointer"
                gap="7"
                href="/players"
                paddinghorizontal="16"
                paddingvertical="9"
                role="link"
                style="transition: background 120ms ease-out; user-select: none; text-decoration: none;"
                tabindex="0"
                tag="a"
              >
                <svg
                  aria-hidden="true"
                  fill="none"
                  height="16"
                  role="presentation"
                  style="display: block; flex-shrink: 0; opacity: 0.8; transition: color 120ms ease-out;"
                  viewBox="0 0 32 32"
                  width="16"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <circle
                    cx="13"
                    cy="12"
                    r="4.5"
                    stroke="var(--textMuted)"
                    stroke-width="2.2"
                  />
                  <path
                    d="M5 26c0-4.5 3.5-8 8-8s8 3.5 8 8"
                    stroke="var(--textMuted)"
                    stroke-linecap="round"
                    stroke-width="2.2"
                  />
                  <circle
                    cx="21"
                    cy="11"
                    opacity="0.45"
                    r="3.5"
                    stroke="var(--textMuted)"
                    stroke-width="1.8000000000000003"
                  />
                  <path
                    d="M24 25c0-3.5-2.5-6-5.5-6"
                    opacity="0.45"
                    stroke="var(--textMuted)"
                    stroke-linecap="round"
                    stroke-width="1.8000000000000003"
                  />
                </svg>
                <span
                  color="$textMuted"
                  font-family="$heading"
                  font-size="13"
                  font-weight="700"
                  letter-spacing="0.78"
                  style="transition: color 120ms ease-out;"
                  texttransform="uppercase"
                >
                  Players
                </span>
              </div>
              <div
                alignitems="center"
                backgroundcolor="transparent"
                borderradius="9999"
                cursor="pointer"
                gap="7"
                href="/games"
                paddinghorizontal="16"
                paddingvertical="9"
                role="link"
                style="transition: background 120ms ease-out; user-select: none; text-decoration: none;"
                tabindex="0"
                tag="a"
              >
                <svg
                  aria-hidden="true"
                  fill="none"
                  height="16"
                  role="presentation"
                  style="display: block; flex-shrink: 0; opacity: 0.8; transition: color 120ms ease-out;"
                  viewBox="0 0 32 32"
                  width="16"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <path
                    d="M18 5L10 17h6l-2 10 8-12h-6l2-10z"
                    fill="rgba(NaN, NaN, NaN, 0.08)"
                    stroke="var(--textMuted)"
                    stroke-linejoin="round"
                    stroke-width="2.2"
                  />
                </svg>
                <span
                  color="$textMuted"
                  font-family="$heading"
                  font-size="13"
                  font-weight="700"
                  letter-spacing="0.78"
                  style="transition: color 120ms ease-out;"
                  texttransform="uppercase"
                >
                  Minigames
                </span>
              </div>
            </div>
            <div
              alignitems="center"
              gap="$2"
            >
              <div
                alignitems="center"
                gap="$2"
              >
                <div>
                  Notification Dropdown
                </div>
                <button>
                  Help
                </button>
                <div>
                  User Profile Dropdown
                </div>
              </div>
            </div>
          </div>
        </div>
        <div
          alignitems="center"
          display="flex"
          gap="$3"
          paddinghorizontal="$4"
          paddingvertical="$3"
        >
          <button
            aria-expanded="false"
            aria-label="Open menu"
            style="background: transparent; border: 0px; color: rgb(222, 230, 255); width: 36px; height: 36px; border-radius: 9999px; display: flex; align-items: center; justify-content: center; cursor: pointer; flex-shrink: 0;"
          >
            Menu
          </button>
          <div>
            League Switcher
          </div>
          <div
            style="flex: 1 1 0%;"
          />
          <button>
            Help
          </button>
          <div>
            Notification Dropdown
          </div>
        </div>
      </div>
    </nav>
  </div>
  <div
    data-testid="main-content"
    flex="1"
    id="main-content"
    padding="$4"
    paddingbottom="$4"
    role="main"
    tabindex="-1"
    tag="main"
  >
    <div>
      Football Hub
    </div>
  </div>
  <div
    display="flex"
  />
</div>
`;

