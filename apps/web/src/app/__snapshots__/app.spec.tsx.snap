exports[`App FootballScreen should match complete football page layout snapshot 1`] = `
<div>
  <div>
    Global Announcer
  </div>
  <a
    class="skip-link sr-only"
    data-testid="skip-link"
    href="#main-content"
  >
    Skip to main content
  </a>
  <div
    position="sticky"
    role="banner"
    top="0"
    zindex="200"
  >
    <div />
    <div>
      <div>
        <a
          aria-label="Legacy Sports home"
          href="/"
          style="text-decoration: none; flex-shrink: 0;"
        >
          <div
            alignitems="center"
            cursor="pointer"
            gap="$2"
          >
            <img
              alt="Legacy Sports"
              src="/logo.png"
              style="height: 38px; width: auto; display: block;"
            />
            <p
              color="#C5A55A"
              data-testid="brand-text"
              font-size="18"
              font-weight="700"
              letter-spacing="0.5"
              marginbottom="0"
              userselect="none"
            >
              Legacy Sports
            </p>
          </div>
        </a>
        <div
          aria-label="Primary"
          as="nav"
          display="none"
          role="navigation"
        >
          <div>
            Sports Dropdown
          </div>
          <div>
            Players Dropdown
          </div>
          <div>
            My Leagues Dropdown
          </div>
          <a
            href="/games/season-draft"
            style="text-decoration: none;"
          >
            <button>
              <div
                alignitems="center"
                gap="$2"
              >
                Gamepad2
                <p
                  marginbottom="0"
                >
                  Games
                </p>
              </div>
            </button>
          </a>
          <div>
            Help Dropdown
          </div>
        </div>
        <div
          alignitems="center"
          flexshrink="0"
          gap="$3"
        >
          <div>
            User Profile Dropdown
          </div>
          <button
            aria-expanded="false"
            aria-label="Open menu"
          >
            Menu
          </button>
        </div>
      </div>
    </div>
  </div>
  <div
    data-testid="main-content"
    flex="1"
    id="main-content"
    padding="$4"
    role="main"
    tabindex="-1"
  >
    <div>
      Football Screen
    </div>
  </div>
</div>
`;

