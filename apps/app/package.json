{
  "name": "app",
  "version": "0.0.1",
  "private": true,
  "main": "src/index.ts",
  "dependencies": {
    "expo": "~51.0.28",
    "react": "18.2.0",
    "react-native": "0.74.5"
  },
  "scripts": {
    "eas-build-pre-install": "cd ../../ && node tools/scripts/eas-build-pre-install.mjs . apps/app && cp package-lock.json apps/app",
    "eas-build-post-install": "cd ../../ && node tools/scripts/eas-build-post-install.mjs . apps/app",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "codegen-db": "graphql-codegen --config codegen.ts",
    "lint:fix": "eslint --fix"
  },
  "devDependencies": {}
}
