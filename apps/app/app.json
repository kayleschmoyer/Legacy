{
  "expo": {
    "name": "Legacy Sports",
    "slug": "app",
    "version": "1.0.0",
    "sdkVersion": "54.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "legacysports",
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.legacysports.app",
      "googleServicesFile": "./ios/GoogleService-Info.plist",
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:legacy-fantasy.com",
        "applinks:app.legacy-fantasy.com"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive_icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.legacysports.app",
      "googleServicesFile": "./android/app/google-services.json",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "legacy-fantasy.com" },
            { "scheme": "https", "host": "app.legacy-fantasy.com" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "build": {
        "babel": {
          "include": ["tamagui"]
        }
      }
    },
    "plugins": [
      "../../lib/app-config/plugins/with-expo-public-env",
      "@react-native-firebase/app",
      [
        "expo-asset",
        {
          "assets": ["./assets"]
        }
      ],
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#0A0F1A"
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.legacy-sports-433915"
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": [],
          "androidMode": "default",
          "androidCollapsedTitle": "Legacy Sports",
          "iosDisplayInForeground": true
        }
      ]
    ]
  }
}
