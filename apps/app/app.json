{
  "expo": {
    "name": "App",
    "slug": "app",
    "version": "1.0.0",
    "sdkVersion": "54.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "legacysports",
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": ["**/*"],
    "extra": {
      "oauthProxyUrl": "http://localhost:5001",
      "googleClientId": "placeholder-google-client-id"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.legacySports",
      "googleServicesFile": "./ios/GoogleService-Info.plist"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive_icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.legacySports",
      "googleServicesFile": "./android/app/google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "build": {
        "babel": {
          "include": ["tamagui"]
        }
      }
    },
    "plugins": [
      "@react-native-firebase/app",
      [
        "expo-asset",
        {
          "assets": ["./assets"]
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.legacy-sports-433915"
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": [],
          "androidMode": "default",
          "androidCollapsedTitle": "Legacy Sports",
          "iosDisplayInForeground": true
        }
      ]
    ]
  }
}
