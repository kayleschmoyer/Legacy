{
  // LS-9873: same file set as tsconfig.spec.json (used unmodified by ESLint's
  // typed-linting parserOptions.project), but with a temporary exclude list for
  // spec files that had pre-existing type errors before this tsconfig was ever
  // wired into a typecheck target. Originally 247 errors across 32 files;
  // LS-9977 burned down 21 of those files (55 errors) by aligning mock/fixture
  // shapes with the current generated GraphQL types. The remaining 11 files
  // (192 errors, concentrated in the league/team detail screens, LeagueChatTab,
  // FootballMatchupScreen, LeagueScoringEditor, and the games/home tabs) are
  // tracked as follow-up work under LS-9977.
  "extends": "./tsconfig.spec.json",
  "exclude": [
    "src/app/(app)/(tabs)/games.spec.tsx",
    "src/app/(app)/(tabs)/home.spec.tsx",
    "src/app/(app)/baseball/league/[leagueId].spec.tsx",
    "src/app/(app)/baseball/team/[teamId].spec.tsx",
    "src/app/(app)/football/league/[leagueId].spec.tsx",
    "src/app/(app)/football/players.spec.tsx",
    "src/app/(app)/football/team/[teamId].spec.tsx",
    "src/features/leagues/LeagueChatTab.spec.tsx",
    "src/features/leagues/LeagueHistoryTab.spec.tsx",
    "src/features/scoring/LeagueScoringEditor.spec.tsx",
    "src/screens/leagues/football/FootballMatchupScreen.component.spec.tsx"
  ]
}
