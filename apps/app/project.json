{
  "name": "app",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/app/src",
  "projectType": "application",
  "tags": [],
  "// targets": "to see all targets run: nx show project app --web",
  "targets": {
    "install": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/app",
        "command": "npm ci"
      }
    },
    // https://github.com/expo/eas-cli/issues/1300#issuecomment-1681581790
    "build-android": {
      "dependsOn": ["run-android"],
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/app",
        "command": "npx react-native build-android --mode=release"
      }
    },
    "run-android": {
      "executor": "@nx/react-native:run-android"
    },
    "build": {
      "dependsOn": ["prebuild", "build-android"]
    }
  }
}
