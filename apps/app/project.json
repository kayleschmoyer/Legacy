{
  "name": "app",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/app/src",
  "projectType": "application",
  "tags": [],
  "// targets": "to see all targets run: nx show project app --web",
  "targets": {
    "build-android": {
      "dependsOn": ["run-android"],
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/app",
        "command": "npx react-native build-android --mode=release"
      }
    },
    "run-android": {
      "executor": "@nx/react-native:run-android"
    },
    "build-ios": {
      "dependsOn": ["run-ios"],
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/app",
        "command": "npx react-native build-ios --mode=release"
      }
    },
    "run-ios": {
      "executor": "@nx/react-native:run-ios"
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'Builds will be run in other workers.'"
      }
    },
    "lint:fix": {
      "executor": "@nx/eslint:lint",
      "options": {
        "fix": true
      }
    }
  }
}
