{
  "name": "app",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/app/src",
  "projectType": "application",
  "tags": ["platform:mobile", "scope:app", "type:frontend"],
  "// targets": "to see all targets run: nx show project app --web",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'Use build-android or build-ios for platform-specific builds'"
      }
    },
    "build-android": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "command": "cd android && chmod +x gradlew && ./gradlew --stop && cp gradle-ci.properties gradle.properties && ./gradlew assembleRelease --no-daemon --stacktrace --no-parallel --max-workers=2 --build-cache --no-scan --quiet",
        "cwd": "apps/app"
      },
      "cache": true,
      "inputs": [
        "default",
        "^production",
        "{projectRoot}/android/**/*",
        "{projectRoot}/index.js",
        "{projectRoot}/metro.config.js",
        "{projectRoot}/babel.config.js",
        "{workspaceRoot}/android/**/*",
        "{workspaceRoot}/app.json",
        "{workspaceRoot}/babel.config.json"
      ],
      "outputs": [
        "{projectRoot}/android/app/build/outputs/apk",
        "{projectRoot}/android/app/build/intermediates/merged_assets"
      ]
    },
    "build-android-debug": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "command": "cd android && chmod +x gradlew && ./gradlew --stop && cp gradle-ci.properties gradle.properties && ./gradlew assembleDebug --no-daemon --stacktrace --no-parallel --max-workers=2 --build-cache --no-scan --quiet",
        "cwd": "apps/app"
      },
      "cache": true,
      "inputs": [
        "default",
        "^production",
        "{projectRoot}/android/**/*",
        "{projectRoot}/index.js",
        "{projectRoot}/metro.config.js",
        "{projectRoot}/babel.config.js",
        "{workspaceRoot}/android/**/*",
        "{workspaceRoot}/app.json",
        "{workspaceRoot}/babel.config.json"
      ],
      "outputs": [
        "{projectRoot}/android/app/build/outputs/apk",
        "{projectRoot}/android/app/build/intermediates/merged_assets"
      ]
    },
    "test-android": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cd android && ./gradlew test",
        "cwd": "apps/app"
      }
    },
    "ios-setup": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cd ios && pod install",
        "cwd": "apps/app"
      }
    },
    "build-ios": {
      "executor": "nx:run-commands",
      "dependsOn": ["ios-setup"],
      "options": {
        "command": "cd ios && xcodebuild -workspace App.xcworkspace -scheme TempIosExtraction -configuration Release -sdk iphonesimulator -arch x86_64 build",
        "cwd": "apps/app"
      }
    },
    "test-ios": {
      "executor": "nx:run-commands",
      "dependsOn": ["ios-setup"],
      "options": {
        "command": "cd ios && xcodebuild -workspace App.xcworkspace -scheme TempIosExtraction -configuration Debug -sdk iphonesimulator -arch x86_64 test",
        "cwd": "apps/app"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec react-native start",
        "cwd": "apps/app"
      }
    },
    "start": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec react-native start",
        "cwd": "apps/app"
      }
    },
    "run-ios": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec react-native run-ios",
        "cwd": "apps/app"
      }
    },
    "run-android": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec react-native run-android",
        "cwd": "apps/app"
      }
    },
    "codegen": {
      "executor": "nx:run-commands",
      "options": {
        "command": "graphql-codegen --require tsconfig-paths/register --config codegen.ts",
        "cwd": "apps/app"
      }
    },
    "codegen:db": {
      "executor": "nx:run-commands",
      "options": {
        "command": "graphql-codegen --require tsconfig-paths/register --config codegen.ts",
        "cwd": "apps/app"
      }
    },
    "android": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec react-native run-android",
        "cwd": "apps/app"
      }
    },
    "ios": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec react-native run-ios",
        "cwd": "apps/app"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/app/jest.config.ts"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["apps/app/**/*.{ts,tsx,js,jsx}"]
      }
    }
  }
}
