{
  "name": "app",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/app/src",
  "projectType": "application",
  "tags": ["platform:mobile", "scope:app", "type:frontend"],
  "// targets": "to see all targets run: nx show project app --web",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'Use build-android or build-ios for platform-specific builds'"
      }
    },
    "prebuild": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx expo prebuild --clean --no-install",
        "cwd": "apps/app"
      }
    },
    "prebuild-android": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx expo prebuild --clean --platform android --no-install",
        "cwd": "apps/app"
      }
    },
    "build-android": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "command": "npx expo prebuild --platform android --no-install && cd android && ./gradlew assembleRelease --no-daemon --stacktrace --no-parallel --max-workers=2 --build-cache --no-scan",
        "cwd": "apps/app"
      },
      "cache": true,
      "outputs": ["{projectRoot}/android/app/build/outputs/apk"]
    },
    "build-android-debug": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "command": "npx expo prebuild --platform android --no-install && cd android && ./gradlew assembleDebug --no-daemon --stacktrace --no-parallel --max-workers=2 --build-cache --no-scan",
        "cwd": "apps/app"
      },
      "cache": true,
      "outputs": ["{projectRoot}/android/app/build/outputs/apk"]
    },
    "test-android": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cd android && ./gradlew test",
        "cwd": "apps/app"
      }
    },
    "ios-setup": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx expo prebuild --platform ios --no-install && cd ios && pod install",
        "cwd": "apps/app"
      }
    },
    "build-ios": {
      "executor": "nx:run-commands",
      "dependsOn": ["ios-setup"],
      "options": {
        "command": "cd ios && xcodebuild -workspace App.xcworkspace -scheme App -configuration Release -sdk iphonesimulator -arch x86_64 build",
        "cwd": "apps/app"
      }
    },
    "test-ios": {
      "executor": "nx:run-commands",
      "dependsOn": ["ios-setup"],
      "options": {
        "command": "cd ios && xcodebuild -workspace App.xcworkspace -scheme App -configuration Debug -sdk iphonesimulator -arch x86_64 test",
        "cwd": "apps/app"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx expo start",
        "cwd": "apps/app"
      }
    },
    "start": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx expo start",
        "cwd": "apps/app"
      }
    },
    "run-ios": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx expo run:ios",
        "cwd": "apps/app"
      }
    },
    "run-android": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx expo run:android",
        "cwd": "apps/app"
      }
    },
    "codegen": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/src/api/db/**/*.graphql",
        "{projectRoot}/codegen.ts",
        "{projectRoot}/tsconfig*.json",
        "{workspaceRoot}/tsconfig.base.json",
        "{workspaceRoot}/lib/codegen/codegen.base.ts",
        "{workspaceRoot}/lambdas/db/schema.graphql",
        { "externalDependencies": ["@graphql-codegen/cli", "tsconfig-paths"] }
      ],
      "outputs": ["{projectRoot}/src/api/db/graphql.generated.ts"],
      "options": {
        "command": "graphql-codegen --require tsconfig-paths/register --config codegen.ts",
        "cwd": "apps/app"
      }
    },
    "codegen:db": {
      "dependsOn": ["codegen"]
    },
    "android": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx expo run:android",
        "cwd": "apps/app"
      }
    },
    "ios": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx expo run:ios",
        "cwd": "apps/app"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["apps/app/**/*.{ts,tsx,js,jsx}"],
        "maxWarnings": 0
      }
    }
  }
}
