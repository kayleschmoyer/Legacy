{
  "name": "web-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/web-e2e/src",
  "projectType": "application",
  "tags": ["platform:web", "scope:e2e", "scope:web", "type:e2e", "type:test"],
  "implicitDependencies": ["web"],
  "// targets": "to see all targets run: nx show project web-e2e --web",
  "// e2e dependsOn": "LS-9069: the Playwright webServer only serves the prebuilt dist/apps/web, so the e2e targets depend on web:build to avoid silently validating a stale bundle (cached — unchanged sources are a cache hit). test:full delegates to e2e to inherit the guard. CI is unaffected: it invokes playwright directly, not these targets.",
  "targets": {
    "typecheck": {
      "options": {
        "command": "tsc --noEmit -p tsconfig.app.json"
      },
      "configurations": {
        "spec": {
          "command": "tsc --noEmit -p tsconfig.spec.json"
        }
      }
    },
    "e2e": {
      "executor": "nx:run-commands",
      "dependsOn": [{ "projects": ["web"], "target": "build" }],
      "options": {
        "command": "playwright test",
        "cwd": "{projectRoot}"
      },
      "configurations": {
        "ci": {
          "command": "playwright test --reporter=junit"
        }
      }
    },
    "e2e:ui": {
      "executor": "nx:run-commands",
      "dependsOn": [{ "projects": ["web"], "target": "build" }],
      "options": {
        "command": "playwright test --ui",
        "cwd": "."
      }
    },
    "e2e:headed": {
      "executor": "nx:run-commands",
      "dependsOn": [{ "projects": ["web"], "target": "build" }],
      "options": {
        "command": "playwright test --headed",
        "cwd": "{projectRoot}"
      }
    },
    "e2e:debug": {
      "executor": "nx:run-commands",
      "dependsOn": [{ "projects": ["web"], "target": "build" }],
      "options": {
        "command": "playwright test --debug",
        "cwd": "{projectRoot}"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node apps/web-e2e/scripts/run-unit-tests.mjs"
      },
      "configurations": {
        "full": {
          "command": "pnpm exec nx run web-e2e:e2e"
        }
      }
    },
    "contract": {
      "executor": "nx:run-commands",
      "options": {
        "command": "playwright test --config=playwright.contract.config.ts --project=web-driver-contract",
        "cwd": "{projectRoot}"
      }
    },
    "contract:native": {
      "executor": "nx:run-commands",
      "options": {
        "command": "playwright test --config=playwright.contract.config.ts --project=native-driver-contract",
        "cwd": "{projectRoot}"
      }
    },
    "integration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "playwright test --config=playwright.integration.config.ts",
        "cwd": "{projectRoot}"
      }
    },
    "integration:ui-driven": {
      "executor": "nx:run-commands",
      "options": {
        "command": "playwright test --config=playwright.integration.config.ts ui.integration",
        "cwd": "{projectRoot}"
      }
    },
    "integration:ui": {
      "executor": "nx:run-commands",
      "options": {
        "command": "playwright test --config=playwright.integration.config.ts --ui",
        "cwd": "{projectRoot}"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["apps/web-e2e/**/*.{ts,tsx,js,jsx}"],
        "maxWarnings": 0
      }
    }
  }
}
