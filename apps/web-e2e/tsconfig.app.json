{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "types": ["node", "@playwright/test"]
  },
  "include": [
    "playwright.config.ts",
    "playwright.integration.config.ts",
    "playwright.native.config.ts",
    "playwright.contract.config.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.js",
    "src/**/*.jsx"
  ],
  "exclude": ["**/*.spec.ts", "**/*.test.ts"]
}
