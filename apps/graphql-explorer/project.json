{
  "name": "graphql-explorer",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/graphql-explorer/src",
  "projectType": "application",
  "tags": [
    "platform:web",
    "scope:app",
    "type:dev-tool"
  ],
  "targets": {
    "build": {
      "executor": "@nx/vite:build",
      "outputs": [
        "{options.outputPath}"
      ],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/graphql-explorer",
        "configFile": "apps/graphql-explorer/vite.config.mts"
      },
      "configurations": {
        "development": {
          "mode": "development"
        },
        "production": {
          "mode": "production"
        }
      }
    },
    "serve": {
      "executor": "@nx/vite:dev-server",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "graphql-explorer:build"
      },
      "configurations": {
        "development": {
          "buildTarget": "graphql-explorer:build:development",
          "hmr": true
        },
        "production": {
          "buildTarget": "graphql-explorer:build:production"
        }
      }
    },
    "preview": {
      "executor": "@nx/vite:preview-server",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "graphql-explorer:build"
      },
      "configurations": {
        "development": {
          "buildTarget": "graphql-explorer:build:development"
        },
        "production": {
          "buildTarget": "graphql-explorer:build:production"
        }
      }
    },
    "test": {
      "executor": "@nx/vite:test",
      "outputs": [
        "{options.reportsDirectory}"
      ],
      "options": {
        "passWithNoTests": true,
        "reportsDirectory": "../../coverage/apps/graphql-explorer"
      }
    }
  }
}
