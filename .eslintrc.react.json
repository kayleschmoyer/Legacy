{
  "root": false,
  "extends": [
    "plugin:@nx/react",
    "./.eslintrc.base.json"
  ],
  "ignorePatterns": [
    "dist",
    "node_modules",
    ".expo",
    "web-build",
    "cache"
  ],
  "overrides": [
    {
      "files": [
        "*.ts",
        "*.tsx",
        "*.js",
        "*.jsx"
      ],
      "rules": {}
    },
    {
      "files": [
        "*.ts",
        "*.tsx"
      ],
      "parserOptions": {
        "project": [
          "tsconfig.*?.json"
        ]
      },
      "rules": {}
    },
    {
      "files": [
        "*.js",
        "*.jsx"
      ],
      "rules": {}
    }
  ]
}