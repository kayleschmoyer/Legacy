# Legacy Sports - Environment Configuration Template
# Copy this file to .env.local for local development
# 
# ⚠️  SECURITY WARNING: Never commit real secrets or production values!
# ⚠️  Always use .env.local (gitignored) for real credentials
# ⚠️  Production values are managed by AWS Secrets Manager and Terraform

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
USE_LOCAL_CREDENTIALS=false
# SECURITY: Production DB credentials are managed by AWS Secrets Manager
# These are safe placeholders for the template. Override in .env.local for local dev.
DB_SECRET_NAME=your-db-secret-name
DB_HOST=your-db-host.rds.amazonaws.com
DB_CERT_PATH=certs/us-east-1-bundle.pem
# SSL override: set to 'true' ONLY for legacy environments where the RDS
# certificate has not been updated to Amazon Root CA (rds-ca-rsa2048-g1).
# Setting this in production is a security risk — prefer updating the RDS cert.
# DB_SSL_SELF_SIGNED=false

# Legacy variables (backward compatibility)
DB_CREDS_PATH=your-db-secret-name

# =============================================================================
# AWS CONFIGURATION
# =============================================================================
AWS_REGION=us-east-1
# SECURITY: Production endpoints are set by AWS Lambda environment variables
# These are safe placeholders for the template. Override in .env.local for local dev.
RDS_PROXY_ENDPOINT=your-rds-proxy-endpoint.rds.amazonaws.com
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/YOUR-AWS-ACCOUNT-ID/your-queue-name.fifo

# =============================================================================
# APPLICATION SECRETS (Never commit real values!)
# =============================================================================
# SECURITY: Never commit real secrets! Use AWS Secrets Manager for production.
# For local development, override these in .env.local (which is gitignored)
#
# Generate secrets: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=your-local-jwt-secret-generate-a-random-string
COOKIE_SECRET=your-local-cookie-secret-generate-a-random-string
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret-from-google-console

# =============================================================================
# OAUTH CONFIGURATION
# =============================================================================
# SECURITY: Use placeholder client IDs here. Override in .env.local for local dev.
EXPO_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
EXPO_PUBLIC_OAUTH_PROXY=https://your-oauth-proxy-endpoint.example.com/oauth
CLIENT_ID=your-google-client-id.apps.googleusercontent.com
DB_HOST_DIRECT=your-db-host.rds.amazonaws.com
VITE_OAUTH_PROXY_URL=http://localhost:5001/oauth
VITE_GRAPHQL_HOST=http://localhost:5000/graphql
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# Discord OAuth Application Client ID — enables "Continue with Discord" button.
# Obtain from https://discord.com/developers/applications after creating an OAuth2 app.
# Also set DISCORD_CLIENT_ID, DISCORD_CLIENT_SECRET, and DISCORD_REDIRECT_URI for the lambda.
VITE_DISCORD_CLIENT_ID=
# Comma-separated origins allowed to make credentialed requests to the OAuth proxy.
# The Lambda defaults to https://legacy-fantasy.com when this variable is not set.
# For local development this is overridden by .env.docker (http://localhost:4200).
CORS_ALLOWED_ORIGINS=

# =============================================================================
# MOBILE PUSH NOTIFICATIONS (Expo)
# =============================================================================
# Expo/EAS projectId for the mobile app. Required by expo-notifications'
# getExpoPushTokenAsync to mint valid push tokens on EAS builds and Expo SDK 54+
# (without it the app logs `No "projectId" found` and device tokens never
# register — LS-7955). apps/app/app.config.js injects this into
# extra.eas.projectId at config-resolution time. Get the UUID from
# https://expo.dev → your project → Project settings. Leave empty for local dev
# builds without EAS setup (push registration is skipped, no error).
# Also provision as a GitHub Actions secret / EAS secret for release builds.
EAS_PROJECT_ID=

DB_HOST_DEV=your-db-host.rds.amazonaws.com
SQS_LOAD_SEASON_STATS_URL=https://sqs.us-east-1.amazonaws.com/YOUR-AWS-ACCOUNT-ID/your-load-season-stats-queue.fifo
SQS_LOAD_GAME_STATS_URL=https://sqs.us-east-1.amazonaws.com/YOUR-AWS-ACCOUNT-ID/your-load-game-stats-queue.fifo
SQS_LOAD_FOOTBALL_STATS_URL=https://sqs.us-east-1.amazonaws.com/YOUR-AWS-ACCOUNT-ID/your-load-football-stats-queue.fifo
SQS_AUTOMATIC_DRAFTS_URL=https://sqs.us-east-1.amazonaws.com/YOUR-AWS-ACCOUNT-ID/your-automatic-drafts-queue.fifo
SQS_SELECT_GAME_URL=https://sqs.us-east-1.amazonaws.com/YOUR-AWS-ACCOUNT-ID/your-select-game-queue.fifo

# =============================================================================
# ROLLBAR ERROR TRACKING
# =============================================================================
# Server-side write access token — used for sourcemap upload during production builds.
# Get from: Rollbar dashboard → your project → Settings → Access Tokens → post_server_item
# Also required as a GitHub Actions secret (ROLLBAR_ACCESS_TOKEN).
ROLLBAR_ACCESS_TOKEN=your-rollbar-server-side-write-token
# Browser-side (post_client_item) token for web app client error tracking.
# The mobile app (Expo) reuses this same value via apps/app/app.config.js,
# which aliases it to EXPO_PUBLIC_ROLLBAR_ACCESS_TOKEN at config-load time.
# Set EXPO_PUBLIC_ROLLBAR_ACCESS_TOKEN explicitly only to override per-platform.
# Also required as a GitHub Actions secret named ROLLBAR_CLIENT_ACCESS_TOKEN
# (consumed as VITE_ROLLBAR_ACCESS_TOKEN by deploy-web.yml and as
# EXPO_PUBLIC_ROLLBAR_ACCESS_TOKEN by build-android-app.yml).
VITE_ROLLBAR_ACCESS_TOKEN=your-rollbar-client-side-write-token
# Read access token for querying the Rollbar API locally (e.g. scripts, CLI tools).
# Get from: Rollbar dashboard → your project → Settings → Access Tokens → read
ROLLBAR_READ_ACCESS_TOKEN=your-rollbar-read-access-token
# Runtime knobs read by lib/rollbar/src/lib/rollbar.node.ts — environment label,
# release tag, and verbose SDK logging ('true'/'false').
ROLLBAR_ENVIRONMENT=
ROLLBAR_RELEASE=
ROLLBAR_VERBOSE=false
# Rolling window (ms) over which identical server-side items (same severity +
# message) are collapsed to one Rollbar report, protecting the itemsPerMinute
# budget from bursts (LS-8343). Default 60000; set to 0 to disable.
ROLLBAR_DEDUPE_WINDOW_MS=
# Web client error-capture sample rate 0..1, default 1.0
# (apps/web/src/config/environment.ts rollbarCaptureRate).
VITE_ROLLBAR_CAPTURE_RATE=

# Release version tracking for error reports
# Helps correlate errors with specific deployments/commits
# Lambda: Set by Terraform from SSM parameter (e.g., "legacy-sports-graphql@1.2.3")
# Web: Use commit SHA from build pipeline
# Mobile: Use app version from package.json or build number
COMMIT_SHA=local-dev
APP_VERSION=0.0.0-dev
VITE_COMMIT_SHA=local-dev
VITE_APP_VERSION=0.0.0-dev
EXPO_PUBLIC_APP_VERSION=0.0.0-dev

INTERNAL_API_BASE_URL=http://localhost:5000

LOG_LEVEL=info
LOG_LOCATION=logs/gql-prod-logs.log
DATABASE_URL="postgresql://postgres:YOUR-PASSWORD@your-db-host:5432/postgres?sslmode=require"
DB_PASSWORD=your-db-password
DB_USER=postgres

# CI readonly DB credentials – used when running migrations locally so the
# 20260303_150000_add_ci_readonly_role migration can create the ci_readonly
# Postgres role with the correct password.
# Both vars are automatically populated by `pnpm run sync-env` (scripts/sync-env.ps1).
CI_READONLY_DB_CREDS_SECRET_NAME=legacy-sports-dev-ci-readonly-db-creds-XXXXXXXX
CI_READONLY_DB_PASSWORD=

# =============================================================================
# IMAGE UPLOAD (image-upload Lambda)
# =============================================================================
# Cloudflare Workers AI for NSFW image classification
# Account ID: From Cloudflare Dashboard → (account selector) → Account ID
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
# API Token: Cloudflare Dashboard → My Profile → API Tokens → Create Token
# Required permission: Workers AI — Read
CLOUDFLARE_AI_API_TOKEN=your-cloudflare-ai-api-token
# S3 bucket where team logo images are stored (set automatically from Terraform outputs)
LOGOS_BUCKET_NAME=legacy-sports-dev-team-logos-xxxxxxxx
# Upload endpoint base URL (set to your API Gateway URL)
VITE_IMAGE_UPLOAD_URL=https://api.legacy-fantasy.com

# =============================================================================
# HOSTED MCP SERVERS (Cognito-authenticated HTTP API Gateway)
# =============================================================================
# These endpoints are populated by `node scripts/mcp-auth.mjs --setup`, which
# runs the Cognito hosted-UI OAuth flow and writes both the API Gateway URLs
# and the ID token to .env.local. See docs/guides/mcp-server-access.md.
#
# You do not need to fill these in by hand — `mcp-auth.mjs` writes them to
# .env.local on first setup and refreshes the token on subsequent runs.
MCP_JIRA_URL=https://<api-id>.execute-api.us-east-1.amazonaws.com
MCP_GITHUB_URL=https://<api-id>.execute-api.us-east-1.amazonaws.com
MCP_CI_URL=https://<api-id>.execute-api.us-east-1.amazonaws.com

# =============================================================================
# INTEGRATION TEST USERS (apps/web-e2e/*.integration.spec.ts)
# =============================================================================
# Real test-user credentials for the live-backend integration suite. Loaded by
# playwright.integration.config.ts (from this .env and an optional .env.e2e) and
# mirrored as GitHub Actions secrets for CI (run-playwright-tests.yml,
# run-integration-tests.yml). The fixtures register/login these users against
# the live OAuth proxy at runtime — no value is hardcoded in source.
#
# The 4 base personas (per-spec fixtures `api`, `api2`, `apiCommissioner`,
# `managerPage1..3`) read their own credentials below. Emails must use the
# @test.legacysports.dev domain so the league-cleanup safety guard recognises
# them (see integration global-setup.ts).
E2E_COMMISSIONER_EMAIL=commissioner@test.legacysports.dev
E2E_COMMISSIONER_PASSWORD=your-commissioner-test-password
E2E_MANAGER_1_EMAIL=manager1@test.legacysports.dev
E2E_MANAGER_1_PASSWORD=your-manager-1-test-password
E2E_MANAGER_2_EMAIL=manager2@test.legacysports.dev
E2E_MANAGER_2_PASSWORD=your-manager-2-test-password
E2E_MANAGER_3_EMAIL=manager3@test.legacysports.dev
E2E_MANAGER_3_PASSWORD=your-manager-3-test-password
#
# Tiered identity pool for the loginAs(tier, seat) helper (LS-8055). A user's
# tier is a DB column (no GraphQL write path), so tiers are pinned to stable,
# pre-provisioned identities (see scratch/provision-tiered-users.mjs):
#   premium (6): E2E_COMMISSIONER + E2E_MANAGER_2 (promoted) + e2e-premium-3..6
#   free    (6): E2E_MANAGER_1 + E2E_MANAGER_3 + e2e-free-3..6
#   admin   (2): e2e-admin-1 (free+admin → tests the isAdmin→premium override),
#                e2e-admin-2 (premium+admin)
# The 10 new pool users (e2e-premium-3..6, e2e-free-3..6, e2e-admin-1/2) have
# deterministic @test.legacysports.dev emails hardcoded in test-user-auth.ts and
# share this single password:
E2E_POOL_PASSWORD=your-e2e-pool-password

# =============================================================================
# FEATURE FLAGS (GrowthBook — docs/feature-flags.md)
# =============================================================================
# GrowthBook SDK client key for the web app. Release builds read the
# GROWTHBOOK_CLIENT_KEY GitHub secret (deploy-web.yml). Leave empty to disable
# the flag SDK — every flag then resolves to its in-code fallback.
VITE_GROWTHBOOK_CLIENT_KEY=
# Mobile mirror EXPO_PUBLIC_GROWTHBOOK_CLIENT_KEY is derived from the VITE_ name
# at prebuild (lib/app-config/plugins/config-aliases.js); set it explicitly only
# to override per-platform.

# =============================================================================
# WEB PUSH (lambdas/notifications + web client)
# =============================================================================
# Wired in terraform/main/lambda-notifications.tf + secrets.tf (VAPID keypair)
# and .github/workflows/deploy-web.yml (VITE_VAPID_PUBLIC_KEY). LS-6838.
# VAPID keypair for Web Push (generate locally: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact URI reported to push services; lambda defaults to
# mailto:push@legacysports.app when unset (lambdas/notifications/src/deliver.ts).
VAPID_SUBJECT=
# SQS queue consumed by the notifications lambda.
NOTIFICATION_QUEUE_URL=
# Web client's copy of the VAPID public key (registry key vapidPublicKey).
VITE_VAPID_PUBLIC_KEY=

# =============================================================================
# APPLE IAP (lambdas/apple-iap)
# =============================================================================
# ⚠️ OPEN dangling config (audit 2026-07-02): no lambda-apple-iap.tf exists —
# the lambda source consumes these but no Terraform env block sets them.
# App Store bundle ID for receipt validation — plain local value…
APPLE_BUNDLE_ID=
# …or the Secrets Manager secret name holding it (production *_SECRET_NAME pattern).
APPLE_BUNDLE_ID_SECRET_NAME=
# "Sandbox" or "Production" (lambdas/apple-iap/src/environment.ts).
EXPECTED_APPLE_ENVIRONMENT=Sandbox

# App Store Server API client (lambdas/db/src/server/app-store-server-api.ts).
# Each value: plain local value, or *_SECRET_NAME holding the Secrets Manager secret name.
APPLE_IAP_KEY_ID=
APPLE_IAP_KEY_ID_SECRET_NAME=
APPLE_IAP_ISSUER_ID=
APPLE_IAP_ISSUER_ID_SECRET_NAME=
# PKCS#8 PEM of the App Store Connect API key (.p8); literal \n is accepted.
APPLE_IAP_PRIVATE_KEY=
APPLE_IAP_PRIVATE_KEY_SECRET_NAME=
# "sandbox" or "production" (default) — selects the API host.
APPLE_ENVIRONMENT=sandbox

# =============================================================================
# PRO-FOOTBALL-REFERENCE SCRAPER (lib/pfr-client)
# =============================================================================
# Cloudflare clearance cookie and the matching browser User-Agent; attached to
# every PFR request when set (lib/pfr-client/src/lib/PFRSession.ts).
PFR_USER_AGENT=
PFR_CF_CLEARANCE=

# =============================================================================
# SAFETY SWITCHES
# =============================================================================
# 'production' makes destructive CLI commands refuse to run
# (apps/cli/src/commands/resetDatabase.ts).
LEGACY_SPORTS_ENV=dev
# 'true' relaxes oauth-proxy cookie/state security for local HTTP only
# (lambdas/oauth-proxy jwt-cookie.ts / oauth-state.ts). Never set in production.
IS_LOCAL=
# Mobile dev only: 'true' returns a fake local user (id: -1); production builds
# throw if set (apps/app/src/common/auth/AuthHooks.ts). Keep commented out.
# EXPO_PUBLIC_BYPASS_AUTH=true

# =============================================================================
# DB TESTS (lambdas/db *.db.spec.ts)
# =============================================================================
# Dedicated database for the lambdas/db DB-spec suite; falls back to
# DATABASE_URL when unset (lambdas/db/integration-test-setup.ts).
TEST_DATABASE_URL=

# =============================================================================
# QUICK START COMMANDS
# =============================================================================
# 
# Test database connection:
#   pnpm run db:test
# 
# Get connection URL:
#   pnpm run db:url
# 
# Connect with psql:
#   pnpm run db:psql
#
# Use production database (requires AWS access):
#   pnpm run db:test:production
