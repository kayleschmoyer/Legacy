# Legacy Sports - Environment Configuration Template
# Copy this file to .env.local for local development
# 
# ⚠️  SECURITY WARNING: Never commit real secrets or production values!
# ⚠️  Always use .env.local (gitignored) for real credentials
# ⚠️  Production values are managed by AWS Secrets Manager and Terraform
#
# Copy this file to .env.local and update values for your setup

# =============================================================================
# DATABASE CONFIGURATION (Choose one option)
# =============================================================================

# Option 1: Local PostgreSQL (Default for development)
USE_LOCAL_CREDENTIALS=true
DB_HOST=localhost:5432
DB_USER=postgres
DB_PASSWORD=your-local-password-here
DB_NAME=legacy_sports_dev

# Option 2: AWS RDS (Production database - requires AWS credentials)
# USE_LOCAL_CREDENTIALS=false
# DB_SECRET_NAME=your-db-secret-name
# DB_HOST=your-db-host.rds.amazonaws.com
# DB_CERT_PATH=certs/us-east-1-bundle.pem

# =============================================================================
# APPLICATION SECRETS (Never commit real values!)
# =============================================================================
# Generate JWT secret: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=your-local-jwt-secret-generate-a-random-string
COOKIE_SECRET=your-local-cookie-secret-generate-a-random-string
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret-from-google-console

# =============================================================================
# AWS CONFIGURATION (Production - set by AWS)
# =============================================================================
AWS_REGION=us-east-1
RDS_PROXY_ENDPOINT=your-rds-proxy-endpoint.rds.amazonaws.com
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/YOUR-AWS-ACCOUNT-ID/your-queue-name.fifo
DB_HOST_DEV=your-db-host.rds.amazonaws.com
SQS_LOAD_SEASON_STATS_URL=https://sqs.us-east-1.amazonaws.com/YOUR-AWS-ACCOUNT-ID/your-queue-name.fifo
SQS_AUTOMATIC_DRAFTS_URL=https://sqs.us-east-1.amazonaws.com/YOUR-AWS-ACCOUNT-ID/your-queue-name.fifo

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# GraphQL API
VITE_GRAPHQL_HOST=http://localhost:5000/graphql

# OAuth Configuration (for web app)
VITE_OAUTH_PROXY_URL=http://localhost:5001/oauth
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
CLIENT_ID=your-google-client-id.apps.googleusercontent.com
DB_HOST_DIRECT=localhost:5432

# Authentication Configuration
# Set to 'true' to enable test mode (bypasses OAuth for development)
VITE_AUTH_TEST_MODE=false

# Development flags
NODE_ENV=development

# =============================================================================
# NX CLOUD CONFIGURATION (Optional)
# =============================================================================
# Get these from https://nx.app if you want to use Nx Cloud
NX_CLOUD_ID=your-nx-cloud-id
NX_CLOUD_ACCESS_TOKEN=your-nx-cloud-access-token

# =============================================================================
# QUICK START COMMANDS
# =============================================================================
# 
# Test database connection:
#   pnpm run db:test
# 
# Get connection URL:
#   pnpm run db:url
# 
# Connect with psql:
#   pnpm run db:psql
#
# Use production database (requires AWS access):
#   pnpm run db:test:production
