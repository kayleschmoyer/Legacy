{
  "$schema": "https://raw.githubusercontent.com/anthropics/claude-code/main/.mcp.schema.json",
  "mcpServers": {
    "legacy-sports-ci": {
      "command": "pnpm",
      "args": ["exec", "tsx", "tools/mcp/ci-server/src/index.ts"]
    },
    "legacy-sports-db": {
      "command": "pnpm",
      "args": ["exec", "tsx", "tools/mcp/db-server/src/index.ts"]
    },
    "legacy-sports-jira": {
      "command": "pnpm",
      "args": ["exec", "tsx", "tools/mcp/jira-server/src/index.ts"],
      "env": {
        "JIRA_EMAIL": "${JIRA_EMAIL}",
        "JIRA_API_TOKEN": "${JIRA_API_TOKEN}"
      }
    },
    "worktree": {
      "command": "pnpm",
      "args": ["exec", "tsx", "tools/mcp/worktree-server/src/index.ts"]
    },
    "legacy-sports-aws": {
      "command": "pnpm",
      "args": ["exec", "tsx", "tools/mcp/aws-server/src/index.ts"]
    },
    "legacy-sports-github": {
      "command": "pnpm",
      "args": ["exec", "tsx", "tools/mcp/github-server/src/index.ts"],
      "env": {
        "GH_TOKEN": "${GITHUB_TOKEN}"
      }
    },
    "legacy-sports-nx": {
      "command": "pnpm",
      "args": ["exec", "tsx", "tools/mcp/nx-server/src/index.ts"]
    },
    "legacy-sports-make": {
      "command": "pnpm",
      "args": ["exec", "tsx", "tools/mcp/make-server/src/index.ts"]
    }
  }
}
