{
  "$schema": "https://raw.githubusercontent.com/anthropics/claude-code/main/.mcp.schema.json",
  "mcpServers": {
    "worktree": {
      "command": "node",
      "args": [
        ".github/copilot/hooks/mcp-bootstrap.mjs",
        "node",
        "--import",
        "tsx",
        "tools/mcp/worktree-server/src/index.ts"
      ]
    },
    "legacy-sports-github": {
      "command": "node",
      "args": [
        ".github/copilot/hooks/mcp-bootstrap.mjs",
        "node",
        "--import",
        "tsx",
        "tools/mcp/github-server/src/index.ts"
      ],
      "env": {
        "GH_TOKEN": "${GH_TOKEN:-}",
        "AGENT_AUTHOR_APP_PRIVATE_KEY": "${AGENT_AUTHOR_APP_PRIVATE_KEY:-}"
      }
    },
    "legacy-sports-jira": {
      "command": "node",
      "args": [
        ".github/copilot/hooks/mcp-bootstrap.mjs",
        "node",
        "--import",
        "tsx",
        "tools/mcp/jira-server/src/index.ts"
      ],
      "env": {
        "JIRA_CLIENT_ID": "${JIRA_CLIENT_ID:-}",
        "JIRA_CLIENT_SECRET": "${JIRA_CLIENT_SECRET:-}",
        "JIRA_CLOUD_ID": "${JIRA_CLOUD_ID:-}",
        "JIRA_SITE_URL": "${JIRA_SITE_URL:-}",
        "JIRA_EMAIL": "${JIRA_EMAIL:-}",
        "JIRA_API_TOKEN": "${JIRA_API_TOKEN:-}"
      }
    },
    "legacy-sports-make": {
      "command": "node",
      "args": [
        ".github/copilot/hooks/mcp-bootstrap.mjs",
        "node",
        "--import",
        "tsx",
        "tools/mcp/make-server/src/index.ts"
      ]
    },
    "legacy-sports-nx": {
      "command": "node",
      "args": [
        ".github/copilot/hooks/mcp-bootstrap.mjs",
        "node",
        "--import",
        "tsx",
        "tools/mcp/nx-server/src/index.ts"
      ]
    },
    "legacy-sports-db": {
      "command": "node",
      "args": [
        ".github/copilot/hooks/mcp-bootstrap.mjs",
        "node",
        "--import",
        "tsx",
        "tools/mcp/db-server/src/index.ts"
      ]
    },
    "legacy-sports-ci": {
      "command": "node",
      "args": [
        ".github/copilot/hooks/mcp-bootstrap.mjs",
        "node",
        "--import",
        "tsx",
        "tools/mcp/ci-server/src/index.ts"
      ]
    },
    "legacy-sports-aws": {
      "command": "node",
      "args": [
        ".github/copilot/hooks/mcp-bootstrap.mjs",
        "node",
        "--import",
        "tsx",
        "tools/mcp/aws-server/src/index.ts"
      ]
    },
    "legacy-sports-browser": {
      "command": "node",
      "args": [
        ".github/copilot/hooks/mcp-bootstrap.mjs",
        "node",
        "--import",
        "tsx",
        "tools/mcp/browser-server/src/index.ts"
      ]
    }
  }
}
