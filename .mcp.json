{
  "$schema": "https://raw.githubusercontent.com/anthropics/claude-code/main/.mcp.schema.json",
  "mcpServers": {
    "worktree": {
      "command": "node",
      "args": [
        ".github/copilot/hooks/mcp-bootstrap.mjs",
        "node",
        "--import",
        "tsx",
        "tools/mcp/worktree-server/src/index.ts"
      ]
    },
    "legacy-sports-github": {
      "url": "${MCP_GITHUB_URL}",
      "headers": {
        "Authorization": "Bearer ${MCP_AUTH_TOKEN}"
      }
    },
    "legacy-sports-jira": {
      "url": "${MCP_JIRA_URL}",
      "headers": {
        "Authorization": "Bearer ${MCP_AUTH_TOKEN}"
      }
    },
    "legacy-sports-make": {
      "command": "node",
      "args": [
        ".github/copilot/hooks/mcp-bootstrap.mjs",
        "node",
        "--import",
        "tsx",
        "tools/mcp/make-server/src/index.ts"
      ]
    },
    "legacy-sports-nx": {
      "command": "node",
      "args": [
        ".github/copilot/hooks/mcp-bootstrap.mjs",
        "node",
        "--import",
        "tsx",
        "tools/mcp/nx-server/src/index.ts"
      ]
    },
    "legacy-sports-db": {
      "command": "node",
      "args": [
        ".github/copilot/hooks/mcp-bootstrap.mjs",
        "node",
        "--import",
        "tsx",
        "tools/mcp/db-server/src/index.ts"
      ]
    },
    "legacy-sports-ci": {
      "url": "${MCP_CI_URL}",
      "headers": {
        "Authorization": "Bearer ${MCP_AUTH_TOKEN}"
      }
    },
    "legacy-sports-ci-local": {
      "command": "node",
      "args": [
        ".github/copilot/hooks/mcp-bootstrap.mjs",
        "node",
        "--import",
        "tsx",
        "tools/mcp/ci-server/src/index.ts"
      ]
    },
    "legacy-sports-aws": {
      "command": "node",
      "args": [
        ".github/copilot/hooks/mcp-bootstrap.mjs",
        "node",
        "--import",
        "tsx",
        "tools/mcp/aws-server/src/index.ts"
      ]
    },
    "legacy-sports-browser": {
      "command": "node",
      "args": [
        ".github/copilot/hooks/mcp-bootstrap.mjs",
        "node",
        "--import",
        "tsx",
        "tools/mcp/browser-server/src/index.ts"
      ]
    },
    "legacy-sports-dev-process": {
      "command": "node",
      "args": [
        ".github/copilot/hooks/mcp-bootstrap.mjs",
        "node",
        "--import",
        "tsx",
        "tools/mcp/dev-process-server/src/index.ts"
      ]
    },
    "stripe": {
      "command": "npx",
      "args": ["-y", "@stripe/mcp@0.3.3", "--tools=all"],
      "env": {
        "STRIPE_SECRET_KEY": "${STRIPE_SECRET_KEY}"
      }
    }
  }
}
