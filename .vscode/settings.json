    "**/certs": true,
    "**/resources": true,
    "**/.tamagui": true,
    "**/terraform.tfstate*": true,
    "**/*.log": true
  },
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/.nx/**": true,
    "**/android/build/**": true,
    "**/android/.gradle/**": true,
    "**/playwright-report/**": true,
    "**/logs/**": true,
    "**/tmp/**": true,
    "**/certs/**": true,
    "**/resources/**": true,
    "**/.tamagui/**": true,
    "**/*.log": true
