    "/^cd \"D:\\\\code\\\\legacy-sports-worktrees\\\\LS-595-matchup-detail-integration-test\" ; node \"D:\\\\code\\\\legacy-sports\\\\node_modules\\\\typescript\\\\bin\\\\tsc\" --noEmit -p apps/web-e2e/tsconfig\\.app\\.json 2>&1 \\| Select-Object -Last 25$/": {
      "approve": true,
