    "/^cd \"D:\\\\code\\\\legacy-sports\" ; node node_modules/nx/bin/nx\\.js run web-e2e:lint --files=\"apps/web-e2e/src/integration/tests/matchup-detail-ui\\.spec\\.ts\" 2>&1 \\| Select-Object -Last 25$/": {
