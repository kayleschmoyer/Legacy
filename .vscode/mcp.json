{
  "inputs": [],
  "servers": {
    "legacy-sports-ci": {
      "type": "stdio",
      "command": "node",
      "args": ["--import", "tsx", "tools/mcp/ci-server/src/index.ts"]
    },
    "legacy-sports-db": {
      "type": "stdio",
      "command": "node",
      "args": ["--import", "tsx", "tools/mcp/db-server/src/index.ts"]
    },
    "legacy-sports-jira": {
      "type": "stdio",
      "command": "node",
      "args": ["--import", "tsx", "tools/mcp/jira-server/src/index.ts"],
      "env": {
        "JIRA_EMAIL": "${env:JIRA_EMAIL}",
        "JIRA_API_TOKEN": "${env:JIRA_API_TOKEN}"
      }
    },
    "worktree": {
      "type": "stdio",
      "command": "node",
      "args": ["--import", "tsx", "tools/mcp/worktree-server/src/index.ts"]
    },
    "legacy-sports-aws": {
      "type": "stdio",
      "command": "node",
      "args": ["--import", "tsx", "tools/mcp/aws-server/src/index.ts"]
    },
    "legacy-sports-github": {
      "type": "stdio",
      "command": "node",
      "args": ["--import", "tsx", "tools/mcp/github-server/src/index.ts"],
      "env": {
        "GH_TOKEN": "${env:GH_TOKEN}",
        "AGENT_AUTHOR_APP_PRIVATE_KEY": "${env:AGENT_AUTHOR_APP_PRIVATE_KEY}"
      }
    },
    "legacy-sports-nx": {
      "type": "stdio",
      "command": "node",
      "args": ["--import", "tsx", "tools/mcp/nx-server/src/index.ts"]
    },
    "legacy-sports-make": {
      "type": "stdio",
      "command": "node",
      "args": ["--import", "tsx", "tools/mcp/make-server/src/index.ts"]
    },
    "legacy-sports-browser": {
      "type": "stdio",
      "command": "node",
      "args": ["--import", "tsx", "tools/mcp/browser-server/src/index.ts"]
    }
  }
}
