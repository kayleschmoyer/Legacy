{
  "targets": {
    "dev:all": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "nx dev web",
          "nx start app",
          "nx watch api"
        ],
        "parallel": true,
        "persistent": true
      }
    },
    "watch:build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "nx watch --projects=lib/** -- nx build $NX_PROJECT_NAME",
        "persistent": true
      }
    },
    "services:start": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "docker-compose up -d postgres",
          "nx dev graphql-server",
          "nx dev web"
        ],
        "parallel": true,
        "persistent": true,
        "cache": false
      }
    }
  }
}