# Add files here to ignore them from prettier formatting
/dist
/coverage
# Content-addressable node_modules pool — never format pooled trees
/.modules-pool
/.nx/cache
/.nx/workspace-data
# Static bundles are checked in but should not be reformatted automatically
static/environment.js
static/main.js
# Design mockups synced from Claude Design — hand-authored snapshots, not source
docs/design/**/scratch/
pnpm-lock.yaml
# Env files have no prettier parser
.env*
# Migrations are append-only and immutable once merged — never reformat them
lib/db-client/migrations/
# Ephemeral agent lock file — stores sessionId/PID/timestamp, not source code
.claude/scheduled_tasks.lock
# Unparseable files — corrupted introspection result (UTF-16) and fully-commented-out GraphQL
apps/web/schema-introspection.json
lib/data-loaders/src/api/db/stats/Stats.graphql
# Synced design bundles — generated by /sync-designs from Claude Design; preserve as-imported
docs/design/
# Kotlin/Android — no Prettier parser; treeless CI clone doesn't fetch these blobs
apps/app/android/
**/*.kt
# Generated per-agent slash-command prompts — byte-exact output of
# scripts/sync-agent-prompts.mjs (source of truth: .claude/commands/);
# reformatting them would break the sync drift check
.github/prompts/
.cursor/commands/
.opencode/commands/
.codex/prompts/
# Generated skill routing index — byte-exact output of
# scripts/generate-skill-index.mjs (source of truth: SKILL.md frontmatter);
# reformatting it would break the sync drift check
.agents/skills/INDEX.md
# Generated MCP API reference — byte-exact output of
# scripts/generate-mcp-api-reference.mjs (source of truth: tools/mcp/*/src/);
# reformatting it would break the sync drift check
docs/mcp/
lib/mcp-docs/src/pages/
# Vendored SchemaStore JSON schemas (LS-9797) — byte-exact copies of upstream,
# refreshed by scripts/update-workflow-schemas.js. Reformatting them would make
# every future upstream diff unreadable and break the `--check` drift compare.
scripts/schemas/*.json
