{
  "name": "tamagui-config",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "lib/tamagui-config/src",
  "projectType": "library",
  "tags": ["platform:shared", "scope:lib", "scope:ui", "type:config"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p tsconfig.lib.json",
        "cwd": "lib/tamagui-config"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "lib/tamagui-config/jest.config.ts",
        "passWithNoTests": true
      },
      "configurations": {
        "ci": {
          "ci": true,
          "coverageReporters": ["text"]
        }
      }
    }
  }
}
