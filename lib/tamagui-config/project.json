        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/lib/tamagui-config",
        "main": "lib/tamagui-config/src/index.ts",
        "tsConfig": "lib/tamagui-config/tsconfig.lib.json",
        "assets": []
      }
    }
  }
}
