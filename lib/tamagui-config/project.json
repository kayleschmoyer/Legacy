{
  "name": "tamagui-config",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "lib/tamagui-config/src",
  "projectType": "library",
  "tags": [
    "platform:shared",
    "scope:lib",
    "scope:ui",
    "type:config"
  ],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
