{
  "name": "shared-components",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "lib/shared-components/src",
  "projectType": "library",
  "tags": ["platform:shared", "scope:lib", "type:ui"],
  "// targets": "to see all targets run: nx show project shared-components --web",
  "targets": {
    "typecheck": {},
    "ui-previews": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec tsx scripts/ui-previews.ts --outDir tmp/ui-previews",
        "cwd": "."
      }
    },
    "test": {
      "executor": "nx:noop",
      "dependsOn": ["test:web", "test:mobile"]
    },
    "test:web": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}/web"],
      "options": {
        "jestConfig": "lib/shared-components/jest.config.web.ts"
      }
    },
    "test:mobile": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}/mobile"],
      "options": {
        "jestConfig": "lib/shared-components/jest.config.mobile.ts"
      }
    },
    "test:stories": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}/stories"],
      "options": {
        "jestConfig": "lib/shared-components/jest.storybook.config.ts"
      }
    },
    "storybook": {
      "executor": "@nx/storybook:storybook",
      "options": {
        "port": 6009,
        "configDir": "lib/shared-components/.storybook"
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    },
    "build-storybook": {
      "executor": "@nx/storybook:build",
      "outputs": ["{workspaceRoot}/dist/storybook"],
      "options": {
        "outputDir": "dist/storybook",
        "configDir": "lib/shared-components/.storybook"
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    }
  }
}
