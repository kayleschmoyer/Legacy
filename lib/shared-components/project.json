{
  "name": "shared-components",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "lib/shared-components/src",
  "projectType": "library",
  "tags": [
    "platform:shared",
    "scope:lib",
    "type:ui"
  ],
  "// targets": "to see all targets run: nx show project shared-components --web",
  "targets": {
    "build": {
      "executor": "nx:noop",
      "dependsOn": [
        "build:web",
        "build:mobile"
      ]
    },
    "test": {
      "executor": "nx:noop",
      "dependsOn": [
        "test:web",
        "test:mobile"
      ]
    },
    "test:web": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}/web"
      ],
      "options": {
        "jestConfig": "lib/shared-components/jest.config.web.ts"
      }
    },
    "test:mobile": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}/mobile"
      ],
      "options": {
        "jestConfig": "lib/shared-components/jest.config.mobile.ts"
      }
    }
  }
}
