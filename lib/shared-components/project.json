{
  "name": "shared-components",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "lib/shared-components/src",
  "projectType": "library",
  "tags": [],
  "// targets": "to see all targets run: nx show project shared-components --web",
  "targets": {
    "build": {
      "executor": "@nx/vite:build",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/lib/shared-components",
        "configFile": "lib/shared-components/vite.config.mts"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "jestConfig": "lib/shared-components/jest.config.ts"
      }
    }
  }
}