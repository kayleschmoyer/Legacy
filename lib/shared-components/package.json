{
  "name": "@legacy-sports/shared-components",
  "version": "0.0.1",
  "private": true,
  "type": "commonjs",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./auth": "./src/entry/auth.ts",
    "./chat": "./src/entry/chat.ts",
    "./commissioner": "./src/entry/commissioner.ts",
    "./draft": "./src/entry/draft.ts",
    "./elite-draft": "./src/entry/elite-draft.ts",
    "./icons": "./src/entry/icons.ts",
    "./leagues": "./src/entry/leagues.ts",
    "./matchup": "./src/entry/matchup.ts",
    "./navigation": "./src/entry/navigation.ts",
    "./notifications": "./src/entry/notifications.ts",
    "./players": "./src/entry/players.ts",
    "./roster": "./src/entry/roster.ts",
    "./season-draft": "./src/entry/season-draft.ts",
    "./sports": "./src/entry/sports.ts",
    "./stats": "./src/entry/stats.ts",
    "./ui": "./src/entry/ui.ts",
    "./utils": "./src/entry/utils.ts"
  },
  "scripts": {
    "codegen": "graphql-codegen --config codegen.ts",
    "storybook": "storybook dev -p 6009 -c .storybook",
    "build-storybook": "storybook build -c .storybook -o ../../dist/storybook",
    "ui-previews": "pnpm exec nx run shared-components:ui-previews",
    "test": "jest --onlyChanged",
    "test:watch": "jest --watch --onlyChanged",
    "test:coverage": "jest --coverage",
    "test:all-files": "jest",
    "test-storybook": "test-storybook",
    "test-storybook:ci": "pnpm exec tsx ../../scripts/test-storybook-ci.ts",
    "test:stories": "jest --config=jest.storybook.config.ts",
    "test:all": "pnpm run test && pnpm run test:stories"
  },
  "dependencies": {
    "@legacy-sports/api": "workspace:*",
    "@legacy-sports/logging": "workspace:*",
    "@legacy-sports/tamagui-config": "workspace:*",
    "@legacy-sports/ui-abstractions": "workspace:*",
    "@legacy-sports/websocket-client": "workspace:*"
  }
}
