{
  "name": "scheduling",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "lib/scheduling/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/lib/scheduling",
        "main": "lib/scheduling/src/index.ts",
        "tsConfig": "lib/scheduling/tsconfig.lib.json",
        "assets": []
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["lib/scheduling/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "lib/scheduling/jest.config.ts",
        "passWithNoTests": false
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --project lib/scheduling/tsconfig.lib.json --noEmit"
      }
    }
  },
  "tags": ["type:lib", "scope:scheduling"]
}
