{
  "name": "ui-abstractions",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "lib/ui-abstractions/src",
  "projectType": "library",
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p tsconfig.lib.json",
        "cwd": "lib/ui-abstractions"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "lib/ui-abstractions/jest.config.ts"
      }
    }
  },
  "tags": [
    "platform:shared",
    "scope:lib",
    "scope:shared",
    "type:ui",
    "type:util"
  ]
}
