{
  "extends": ["../../.eslintrc.json", "../../.eslintrc.hermes.json"],
  "ignorePatterns": ["!**/*", "node_modules", "jest.config.ts", "**/*.d.ts"],
  "overrides": [
    {
      "files": ["*.ts", "*.tsx"],
      "parserOptions": {
        "project": ["tsconfig.*?.json"]
      },
      "rules": {
        "no-console": "off"
      }
    }
  ]
}
