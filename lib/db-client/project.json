{
  "name": "db-client",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "lib/db-client/src",
  "projectType": "library",
  "tags": [
    "platform:shared",
    "scope:lib",
    "type:data"
  ],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/lib/db-client",
        "main": "lib/db-client/src/index.ts",
        "tsConfig": "lib/db-client/tsconfig.lib.json",
        "assets": []
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p tsconfig.lib.json",
        "cwd": "lib/db-client"
      }
    }
  }
}
