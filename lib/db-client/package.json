{
  "name": "@legacy-sports/db-client",
  "version": "0.0.1",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "generate:migration:public": "drizzle-kit generate --config drizzle.config.public.ts",
    "generate:migration:internal": "drizzle-kit generate --config drizzle.config.internal.ts",
    "migrate:public": "drizzle-kit migrate --config drizzle.config.public.ts",
    "migrate:internal": "drizzle-kit migrate --config drizzle.config.internal.ts",
    "migrate": "powershell -ExecutionPolicy Bypass -File ./scripts/migrate-basic.ps1",
    "migrate:dry-run": "powershell -ExecutionPolicy Bypass -File ./scripts/migrate-basic.ps1 -DryRun",
    "migrate:public-only": "powershell -ExecutionPolicy Bypass -File ./scripts/migrate-basic.ps1 -PublicOnly",
    "migrate:internal-only": "powershell -ExecutionPolicy Bypass -File ./scripts/migrate-basic.ps1 -InternalOnly",
    "introspect:public": "drizzle-kit introspect --config drizzle.config.public.ts",
    "introspect:internal": "drizzle-kit introspect --config drizzle.config.internal.ts",
    "studio:public": "drizzle-kit studio --config drizzle.config.public.ts",
    "studio:internal": "drizzle-kit studio --config drizzle.config.internal.ts",
    "db:reset": "echo 'This will reset your database. Make sure you want to do this!' && npm run generate:migration:public && npm run generate:migration:internal"
  }
}