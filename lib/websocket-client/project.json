    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p tsconfig.lib.json",
        "cwd": "lib/websocket-client"
      }
    }
  },
  "tags": ["type:lib", "scope:shared"]
}
