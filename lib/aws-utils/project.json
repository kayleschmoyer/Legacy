{
  "name": "aws-utils",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "lib/aws-utils/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/lib/aws-utils",
        "main": "lib/aws-utils/src/index.ts",
        "tsConfig": "lib/aws-utils/tsconfig.lib.json",
        "assets": ["lib/aws-utils/*.md"]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "lib/aws-utils/jest.config.ts",
        "passWithNoTests": true
      },
      "configurations": {
        "ci": {
          "ci": true,
          "coverageReporters": ["text"]
        }
      }
    }
  },
  "tags": ["scope:server", "type:util"]
}