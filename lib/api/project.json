{
  "name": "api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "lib/api/src",
  "projectType": "library",
  "tags": ["platform:shared", "scope:lib", "type:api"],
  "// targets": "to see all targets run: nx show project api --web",
  "targets": {
    "build": {
      "executor": "@nx/vite:build",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/api",
        "configFile": "lib/api/vite.config.mts"
      }
    },
    "typecheck": {}
  }
}
