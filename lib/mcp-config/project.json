{
  "name": "mcp-config",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "lib/mcp-config/src",
  "projectType": "library",
  "tags": ["platform:shared", "scope:lib", "type:util"],
  "targets": {
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/lib/mcp-config"],
      "options": {
        "jestConfig": "lib/mcp-config/jest.config.cts"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p tsconfig.json"
      }
    }
  }
}
